@{
    ViewData["Title"] = "Hướng dẫn";
    var myRoles = AppRoles.Assignable.Append(AppRoles.LegacyStaff).Where(User.IsInRole).Select(AppRoles.Label).ToList();
    var showOrders = User.HasPermission(Permissions.Orders.View);
    var showBookings = User.HasPermission(Permissions.Bookings.View);
    var showInquiries = User.HasPermission(Permissions.Inquiries.View);
    var showDealers = User.HasPermission(Permissions.Dealers.View);
    var showApplications = User.HasPermission(Permissions.Applications.View);
    var showInventory = User.HasPermission(Permissions.Inventory.View);
    var showCatalog = User.HasPermission(Permissions.Categories.View) || User.HasPermission(Permissions.Products.View)
                      || User.HasPermission(Permissions.Services.View) || User.HasPermission(Permissions.Colors.View);
    var showPosts = User.HasPermission(Permissions.Posts.Manage);
    var showCms = User.HasPermission(Permissions.CmsPages.View) || User.HasPermission(Permissions.Menus.Manage)
                  || User.HasPermission(Permissions.HomeSlides.Manage) || User.HasPermission(Permissions.Media.Manage);
    var showSettings = User.HasPermission(Permissions.SiteSettings.Manage) || User.HasPermission(Permissions.Shipping.Manage)
                       || User.HasPermission(Permissions.Users.Manage) || User.HasPermission(Permissions.EmailTemplates.Manage);
    var showEmployees = User.HasPermission(Permissions.Employees.View);
}

<div class="admin-page-head">
    <h1>Hướng dẫn sử dụng Admin</h1>
    <p class="muted">Vai trò của bạn: <strong>@(myRoles.Count > 0 ? string.Join(", ", myRoles) : "-")</strong>. Trang chỉ hiện các mục bạn có quyền.</p>
</div>

<nav class="help-toc admin-help-toc" aria-label="Mục lục">
    <strong>Mục lục</strong>
    <ol>
        <li><a href="#dang-nhap">Đăng nhập &amp; phân quyền</a></li>
        @if (showOrders) { <li><a href="#don-hang">Đơn hàng</a></li> }
        @if (showInventory) { <li><a href="#kho">Kho</a></li> }
        @if (showBookings) { <li><a href="#dat-lich">Đặt lịch dịch vụ</a></li> }
        @if (showInquiries) { <li><a href="#lien-he">Liên hệ (Inquiries)</a></li> }
        @if (showDealers) { <li><a href="#dai-ly">Đại lý &amp; chiết khấu</a></li> }
        @if (showApplications) { <li><a href="#ho-so">Hồ sơ ứng tuyển</a></li> }
        @if (showEmployees) { <li><a href="#nhan-vien">Nhân viên &amp; tài khoản</a></li> }
        @if (showCatalog) { <li><a href="#catalog">Danh mục / Sản phẩm / Dịch vụ / Màu</a></li> }
        @if (showPosts) { <li><a href="#posts">Tin tức &amp; tin tuyển dụng</a></li> }
        @if (showCms) { <li><a href="#cms">CMS &amp; media</a></li> }
        @if (showSettings) { <li><a href="#cai-dat">Cài đặt website</a></li> }
    </ol>
</nav>

<section id="dang-nhap" class="help-section admin-help-section">
    <h2>Đăng nhập &amp; phân quyền</h2>
    <ol class="help-flow">
        <li>
            <span class="help-flow__num">1</span>
            <div>
                <strong>Mở trang đăng nhập</strong>
                <span>Truy cập <code>/admin/login</code> bằng tài khoản Super Admin đã cấp cho bạn.</span>
            </div>
        </li>
        <li>
            <span class="help-flow__num">2</span>
            <div>
                <strong>Vào Dashboard</strong>
                <span>Sau khi đăng nhập bạn vào <code>/admin</code>. Role có quyền doanh thu thấy KPI Doanh thu / Số đơn / AOV và biểu đồ; mọi role thấy strip <em>Cần xử lý</em> theo quyền của mình.</span>
            </div>
        </li>
    </ol>
    <div class="help-callout">
        <strong>Vai trò</strong>
        <ul>
            <li><strong>@AppRoles.Label(AppRoles.SuperAdmin):</strong> toàn quyền, gồm Users và cấu hình website.</li>
            <li><strong>@AppRoles.Label(AppRoles.SalesManager):</strong> đơn hàng (gồm hủy đơn, export), catalog, đặt lịch, liên hệ, đại lý / bảng chiết khấu theo SKU, xem kho, biểu đồ doanh thu.</li>
            <li><strong>@AppRoles.Label(AppRoles.SalesStaff):</strong> tạo / xử lý đơn (không hủy, không export), đặt lịch, liên hệ, xem catalog và đại lý.</li>
            <li><strong>@AppRoles.Label(AppRoles.WarehouseManager):</strong> toàn bộ kho (nhập, điều chỉnh, vị trí, cài đặt kho), giao đơn (Processing / Shipped / Delivered).</li>
            <li><strong>@AppRoles.Label(AppRoles.WarehouseStaff):</strong> nhập kho, xem lô và lịch sử kho, giao đơn.</li>
            <li><strong>@AppRoles.Label(AppRoles.HrManager):</strong> hồ sơ nhân viên (thêm / sửa), hồ sơ ứng tuyển, tin tức / tin tuyển dụng, trang nội dung, menu, slide.</li>
            <li><strong>@AppRoles.Label(AppRoles.HrStaff):</strong> xem hồ sơ nhân viên (không sửa); hồ sơ ứng tuyển / tin / CMS như @AppRoles.Label(AppRoles.HrManager) trừ sửa meta trang và menu.</li>
        </ul>
        <p class="muted" style="margin:0.5rem 0 0">Mỗi tài khoản chỉ có <strong>một</strong> vai trò. Cần thêm quyền: liên hệ Super Admin. Thông báo (chuông) cũng chỉ hiện loại thuộc quyền của bạn.</p>
        <p class="muted" style="margin:0.5rem 0 0">Trên lịch sử đơn / đặt lịch / kho / audit, người thao tác (Actor) ưu tiên hiện <strong>mã nhân viên</strong> (vd. <code>AnNK</code>), không còn hiện email.</p>
    </div>
</section>

@if (showOrders)
{
<section id="don-hang" class="help-section admin-help-section help-section--highlight">
    <h2>Đơn hàng</h2>
    <p>Menu <strong>Đơn hàng</strong> → <code>/admin/Orders</code>. Lọc theo trạng thái / phương thức thanh toán / ngày đặt, tìm theo mã đơn, tên, email, SĐT. Mở icon mắt ở cột Actions để xem <strong>Chi tiết</strong>. Nút nào không có quyền sẽ không hiện.</p>

    <h3>Danh sách đơn</h3>
    <figure class="help-figure">
        <img src="~/help/admin/annotated/01-orders-list.png" alt="Danh sách đơn hàng Admin với chú thích lọc và mở chi tiết" width="1024" height="639" loading="lazy" />
        <figcaption>① Lọc / tìm đơn · ② Mở Chi tiết · ③ Cột Status</figcaption>
    </figure>

    <h3>Quy trình theo phương thức thanh toán (bước đầu)</h3>
    <div class="help-callout">
        <ul>
            <li><strong>COD</strong>: đơn mới thường ở <code>AwaitingConfirmation</code> → gọi/email xác nhận → ghi <em>Ghi chú nội bộ</em> → nhấn <strong>Xác nhận COD</strong> → <code>Confirmed</code>.</li>
            <li><strong>Chuyển khoản</strong>: đơn ở <code>PendingPayment</code> → đối chiếu đã nhận tiền → <strong>Xác nhận CK</strong> → <code>Confirmed</code> (Super Admin / @AppRoles.Label(AppRoles.SalesManager)).</li>
        </ul>
    </div>

    <h3>Sau khi đã Confirmed: luồng xử lý</h3>
    <p><code>Confirmed</code> → ghi chú nội bộ nếu cần → nhấn <strong>Bắt đầu xử lý</strong> → <code>Processing</code>.</p>
    <figure class="help-figure">
        <img src="~/help/admin/annotated/02-order-confirmed.png" alt="Chi tiết đơn Confirmed với nút Bắt đầu xử lý" width="1024" height="810" loading="lazy" />
        <figcaption>① Status Confirmed · ② Ghi chú nội bộ · ③ Bắt đầu xử lý</figcaption>
    </figure>

    <p><code>Processing</code> → khi đã chuyển giao vận, nhấn <strong>Đã giao vận</strong> → <code>Shipped</code>. (Từ <code>Shipped</code> nhấn <strong>Hoàn thành</strong> → <code>Delivered</code>.)</p>
    <figure class="help-figure">
        <img src="~/help/admin/annotated/03-order-processing.png" alt="Chi tiết đơn Processing với nút Đã giao vận" width="1024" height="801" loading="lazy" />
        <figcaption>① Status Processing · ② Đã giao vận</figcaption>
    </figure>

    <p>Khi đơn <code>Delivered</code>, không còn nút đổi trạng thái. Dùng phần <strong>Lịch sử cập nhật</strong> để đối chiếu ai đã thao tác khi nào (tên người thao tác ưu tiên là <strong>mã NV</strong>).</p>
    <figure class="help-figure">
        <img src="~/help/admin/annotated/04-order-delivered.png" alt="Chi tiết đơn Delivered với lịch sử cập nhật" width="1024" height="802" loading="lazy" />
        <figcaption>① Status Delivered · ② Lịch sử cập nhật</figcaption>
    </figure>

    @if (User.HasPermission(Permissions.Orders.Cancel))
    {
        <p><strong>Hủy đơn:</strong> khả dụng khi đơn còn ở AwaitingConfirmation / PendingPayment / Confirmed / Processing. Chỉ Super Admin và @AppRoles.Label(AppRoles.SalesManager) được hủy.</p>
    }
    @if (User.HasPermission(Permissions.Orders.PreviewStockPick))
    {
        <p><strong>Gợi ý lấy hàng (FEFO):</strong> đơn <code>Confirmed</code> hiện vị trí / lô nên lấy (HSD gần nhất lấy trước). Lô đã quá hạn (HSD trước hôm nay) không bao giờ được chọn: số lượng trong lô quá hạn tính là thiếu hàng. Khi chuyển <code>Processing</code>, hệ thống trừ tồn theo gợi ý này; nếu thiếu, đơn vẫn chuyển trạng thái và hệ thống email cảnh báo thiếu hàng.</p>
    }
    @if (User.HasPermission(Permissions.Orders.Create))
    {
        <p class="muted">Đơn mới (web, tạo tay, import) bắt buộc <strong>CCCD</strong> (9 hoặc 12 chữ số) để xuất hóa đơn, và địa chỉ 3 trường: <strong>Tỉnh/Thành phố</strong> (mã <code>ProvinceCode</code> theo danh mục 34 tỉnh), <strong>Xã/Phường</strong> (<code>CommuneCode</code>), <strong>địa chỉ</strong> (số nhà, đường, 5-500 ký tự). File import Excel thêm cột <code>ProvinceCode</code> và <code>CommuneCode</code>. Đơn <strong>đại lý</strong> chỉ tạo tay: chọn loại khách Đại lý, prefill hồ sơ (kèm tỉnh/xã); hệ thống tự áp chiết khấu <strong>theo SKU</strong> từ bảng mặc định / % riêng đại lý (xem <a href="#chiet-khau-dai-ly">Chiết khấu đại lý</a>). Staff có quyền có thể sửa tay % từng dòng (bắt buộc ghi chú nội bộ).</p>
    }
    <p class="muted">Gợi ý: luôn cập nhật <em>Ghi chú nội bộ</em> (đã gọi lúc nào, khách xác nhận gì) trước khi đổi trạng thái.</p>
</section>
}

@if (showInventory)
{
<section id="kho" class="help-section admin-help-section">
    <h2>Kho</h2>
    <p>Menu <strong>Kho</strong> → <code>/admin/Inventory</code>. Đầu trang là các chỉ số: giá trị kho, lô sắp hết hạn, SKU tồn thấp, lô quá hạn. Lô quá hạn không được xuất cho đơn hàng; dùng <strong>Điều chỉnh</strong> để hủy số lượng sau khi xử lý.</p>
    <ul>
        @if (User.HasPermission(Permissions.Inventory.ViewLots))
        {
            <li><strong>Xem lô</strong>: bấm mũi tên ở đầu dòng vị trí để xem SKU, lô, HSD, số lượng tại vị trí đó.</li>
        }
        @if (User.HasPermission(Permissions.Inventory.Receive))
        {
            <li><strong>Nhập kho</strong>: nút <strong>+</strong> trên thanh công cụ, gõ tên / SKU để chọn biến thể, chọn vị trí, nhập mã lô (tuỳ chọn), HSD, giá vốn (định dạng VNĐ khi rời ô), số lượng.</li>
        }
        @if (User.HasPermission(Permissions.Inventory.Adjust))
        {
            <li><strong>Điều chỉnh</strong>: icon bút ở dòng lô, nhập số lượng còn lại và ghi chú lý do (kiểm kê, hỏng, …).</li>
        }
        @if (User.HasPermission(Permissions.Inventory.ViewHistory))
        {
            <li><strong>Lịch sử</strong>: các lần nhập / xuất kho, lọc theo loại (Nhập / Xuất) và khoảng ngày; cột người thực hiện ưu tiên hiện mã NV.</li>
        }
        @if (User.HasPermission(Permissions.Inventory.ManageSettings))
        {
            <li><strong>Cài đặt kho</strong> (<code>/admin/InventorySettings</code>): ngưỡng tồn thấp, số ngày cảnh báo sắp hết hạn, thêm / sửa vị trí kho.</li>
        }
    </ul>
</section>
}

@if (showBookings)
{
<section id="dat-lich" class="help-section admin-help-section">
    <h2>Đặt lịch dịch vụ</h2>
    <p>Menu <strong>Đặt lịch</strong> → <code>/admin/ServiceBookings</code>. Lọc theo trạng thái, mở <strong>Chi tiết</strong>, cập nhật Status + <em>Ghi chú nội bộ</em>. Khi bấm <strong>Hoàn thành</strong>, bắt buộc nhập <strong>CCCD</strong> (9 hoặc 12 chữ số) và <strong>Thành tiền</strong>.</p>
    <ul>
        <li><code>New</code> - vừa nhận từ website</li>
        <li><code>Confirmed</code> - đã liên hệ / chốt lịch với khách</li>
        <li><code>Completed</code> - đã hoàn thành dịch vụ</li>
        <li><code>Cancelled</code> - hủy</li>
    </ul>
</section>
}

@if (showInquiries)
{
<section id="lien-he" class="help-section admin-help-section">
    <h2>Liên hệ (Inquiries)</h2>
    <p>Menu <strong>Liên hệ</strong> → <code>/admin/Inquiries</code>. Đây là tin nhắn từ trang Liên hệ của khách. Lọc theo trạng thái, tìm theo tên / email / SĐT.</p>

    <h3>Danh sách</h3>
    <figure class="help-figure">
        <img src="~/help/admin/annotated/07-inquiries-list.png" alt="Danh sách liên hệ Admin với chú thích lọc và mở chi tiết" width="1024" height="639" loading="lazy" />
        <figcaption>① Lọc / tìm · ② Mở Chi tiết · ③ Cột Status</figcaption>
    </figure>

    <h3>Chi tiết &amp; xử lý</h3>
    <p>Mở icon mắt → đọc nội dung, đổi <strong>Status</strong>, ghi <em>Ghi chú</em> → nhấn <strong>Lưu</strong>.</p>
    <ul>
        <li><code>New</code> - vừa nhận</li>
        <li><code>InProgress</code> - đang xử lý / đã liên hệ</li>
        <li><code>Resolved</code> - đã xử lý xong</li>
        <li><code>Closed</code> - đóng</li>
    </ul>
    <figure class="help-figure">
        <img src="~/help/admin/annotated/08-inquiries-detail.png" alt="Modal chi tiết inquiry với Status và Lưu" width="1024" height="639" loading="lazy" />
        <figcaption>① Nội dung tin nhắn · ② Đổi Status · ③ Ghi chú · ④ Lưu</figcaption>
    </figure>
</section>
}

@if (showDealers)
{
<section id="dai-ly" class="help-section admin-help-section help-section--highlight">
    <h2>Đại lý &amp; chiết khấu</h2>
    <p>Menu <strong>Đại lý</strong> → <code>/admin/Dealers</code>. Khách đăng ký trên web ở trạng thái <code>Pending</code> (kèm CCCD).</p>
    @if (User.HasPermission(Permissions.Dealers.Approve))
    {
        <p>Mở chi tiết: kiểm tra/sửa CCCD → <strong>Duyệt</strong> hoặc <strong>Từ chối</strong>. Đại lý đã duyệt: sửa hồ sơ / ghi chú nội bộ; chỉnh <strong>% riêng</strong> theo bảng SKU (không còn % chung cả hồ sơ). Nút <strong>Thêm</strong> tạo thẳng đại lý <code>Approved</code> (CCCD bắt buộc).</p>
    }
    else
    {
        <p>Bạn xem được hồ sơ đại lý; duyệt và quản lý bảng chiết khấu do @AppRoles.Label(AppRoles.SalesManager) thực hiện.</p>
    }
    <p>Đơn xuất đại lý: <strong>Đơn hàng → Thêm đơn</strong> → loại khách <em>Đại lý</em> → chọn hồ sơ đã duyệt (prefill tên/SĐT/email/địa chỉ/CCCD). Website / mã truy cập đại lý cũng áp cùng bảng CK theo SKU khi đặt hàng.</p>

    <h3 id="chiet-khau-dai-ly">Chiết khấu đại lý (theo SKU)</h3>
    <p>Menu <strong>Chiết khấu đại lý</strong> → <code>/admin/DealerDiscounts</code> (quyền <code>Dealers.ManageDiscounts</code> để sửa; role xem vẫn thấy bảng).</p>
    <div class="help-callout">
        <strong>Quy tắc tính</strong>
        <ul>
            <li><strong>Đơn vị cấu hình là SKU</strong> (biến thể / <code>ProductVariant</code>), không còn theo cả sản phẩm. Hai SKU cùng sản phẩm có thể khác %.</li>
            <li><strong>Nhóm:</strong> nhiều SKU trong một nhóm. <strong>Số lượng cộng chung</strong> mọi SKU trong nhóm trên đơn/giỏ → chọn mức (tier), ví dụ 1-19 / 20-50 / Từ 51.</li>
            <li><strong>% mặc định:</strong> từng ô (SKU × mức) trên bảng nhóm. Áp cho mọi đại lý trừ khi có % riêng.</li>
            <li><strong>% riêng đại lý:</strong> trên chi tiết đại lý → <em>Sửa % riêng</em>. Ô trống = theo bảng mặc định. Badge <em>Có % riêng</em> trên danh sách Dealers.</li>
            <li><strong>SKU chưa cấu hình:</strong> danh sách cảnh báo trên trang CK; đơn đại lý tính <strong>0%</strong> cho SKU đó.</li>
            <li>Đổi bảng chỉ ảnh hưởng <strong>đơn tạo sau khi lưu</strong>; đơn cũ giữ snapshot % / số tiền đã ghi trên dòng.</li>
        </ul>
    </div>
    <ol class="help-flow">
        <li>
            <span class="help-flow__num">1</span>
            <div>
                <strong>Tạo nhóm</strong>
                <span>Thêm (+) → đặt tên nhóm → khai mức số lượng liên tiếp (mức đầu từ 1; mức cuối để trống Đến = trở lên) → tích các SKU → nhập đủ % mặc định cho mọi SKU × mức → Lưu.</span>
            </div>
        </li>
        <li>
            <span class="help-flow__num">2</span>
            <div>
                <strong>(Tuỳ chọn) % riêng theo đại lý</strong>
                <span>Dealers → mở đại lý → Sửa % riêng → điền ô cần lệch so với mặc định → Lưu. Bỏ trống ô = theo mặc định.</span>
            </div>
        </li>
        <li>
            <span class="help-flow__num">3</span>
            <div>
                <strong>Đặt / tạo đơn đại lý</strong>
                <span>Hệ thống chọn mức theo tổng SL nhóm, áp % từng dòng SKU. Sửa tay % dòng (nếu có quyền Override) bắt buộc ghi chú nội bộ.</span>
            </div>
        </li>
    </ol>
    <p class="muted">Một SKU chỉ thuộc một nhóm. Xóa mức hoặc bỏ SKU khỏi nhóm sẽ xóa % riêng đại lý gắn ô đó.</p>
</section>
}

@if (showApplications)
{
<section id="ho-so" class="help-section admin-help-section">
    <h2>Hồ sơ ứng tuyển</h2>
    <p>Menu <strong>Hồ sơ ứng tuyển</strong> → <code>/admin/Applications</code> (tiêu đề trang: <em>Hồ sơ tuyển dụng</em>). Lọc theo trạng thái / tin tuyển dụng, tìm theo tên, email, SĐT.</p>

    <h3>Danh sách hồ sơ</h3>
    <figure class="help-figure">
        <img src="~/help/admin/annotated/05-applications-list.png" alt="Danh sách hồ sơ tuyển dụng với chú thích lọc và mở chi tiết" width="1024" height="639" loading="lazy" />
        <figcaption>① Lọc / tìm hồ sơ · ② Có CV / xem CV · ③ Mở Chi tiết</figcaption>
    </figure>

    <h3>Chi tiết &amp; xử lý</h3>
    <p>Trong modal: xem vị trí ứng tuyển, thông tin ứng viên, tải CV (nếu có). Đổi <strong>Status</strong>, ghi <em>Ghi chú</em>, rồi nhấn <strong>Lưu</strong>.</p>
    <ul>
        <li><code>New</code> - vừa nhận</li>
        <li><code>Reviewing</code> - đang xem xét</li>
        <li><code>Accepted</code> - đạt / tiếp nhận</li>
        <li><code>Rejected</code> - không phù hợp</li>
        <li><code>Closed</code> - đóng hồ sơ</li>
    </ul>
    <figure class="help-figure">
        <img src="~/help/admin/annotated/06-applications-detail.png" alt="Modal chi tiết hồ sơ ứng tuyển với Status và Lưu" width="1024" height="639" loading="lazy" />
        <figcaption>① Thông tin ứng viên + CV · ② Đổi Status · ③ Ghi chú · ④ Lưu</figcaption>
    </figure>
</section>
}

@if (showEmployees)
{
<section id="nhan-vien" class="help-section admin-help-section help-section--highlight">
    <h2>Nhân viên &amp; tài khoản</h2>
    <p>Quy trình chuẩn: <strong>tạo hồ sơ nhân viên trước</strong>, cấp / gắn tài khoản đăng nhập sau. Menu <strong>Nhân viên</strong> → <code>/admin/Employees</code>.</p>

    <h3>1. Thêm nhân viên (HR)</h3>
    <ol class="help-flow">
        <li>
            <span class="help-flow__num">1</span>
            <div>
                <strong>Nhấn Thêm (+)</strong>
                <span>Nhập họ tên (bắt buộc) và các thông tin cá nhân / công việc nếu đã có. Chưa cần email đăng nhập.</span>
            </div>
        </li>
        <li>
            <span class="help-flow__num">2</span>
            <div>
                <strong>Lưu → hệ thống cấp mã NV</strong>
                <span>Mã sinh từ họ tên (bỏ dấu): tên gọi + chữ cái đầu của họ/đệm. Ví dụ <em>Nguyễn Kim An</em> → <code>AnNK</code>; <em>Văn Thị Thu Thủy</em> → <code>ThuyVTT</code>. Trùng tên thì thêm số: <code>AnNK2</code>, <code>AnNK3</code>, … Mã đã cấp không đổi khi sửa họ tên sau này. Hồ sơ cũ dạng <code>NV0001</code> giữ nguyên.</span>
            </div>
        </li>
    </ol>
    <div class="help-callout">
        <strong>Trạng thái trên danh sách</strong>
        <ul>
            <li><em>Chưa có tài khoản</em> - đã có hồ sơ HR, chưa đăng nhập được Admin.</li>
            <li><em>Chưa bổ sung hồ sơ</em> - tài khoản cũ (legacy) chưa có hồ sơ NV; HR mở Sửa và lưu lần đầu để cấp mã.</li>
            <li><em>Chưa đủ thông tin cá nhân</em> - thiếu ngày sinh / SĐT / địa chỉ / CCCD.</li>
        </ul>
    </div>

    <h3>2. Cấp tài khoản từ hồ sơ nhân viên</h3>
    <p>Cần có <strong>Email cá nhân</strong> trên hồ sơ trước. Super Admin (quyền Users) mở hồ sơ NV chưa có tài khoản → <strong>Cấp tài khoản</strong> → email đăng nhập lấy sẵn từ Email cá nhân (không sửa trên form), nhập mật khẩu + role → Lưu. Họ tên lấy từ hồ sơ NV.</p>

    <h3>3. Gắn nhân viên khi tạo / sửa Users</h3>
    <p>Menu <strong>Users</strong> → Thêm / Sửa → chọn <strong>Gắn nhân viên</strong> (danh sách NV chưa gắn, hoặc NV đang gắn với user này). Khi chọn NV, email đăng nhập và họ tên điền từ hồ sơ (Email cá nhân). Có thể tạo user không gắn NV (tooling); khi đó nhập email thủ công và không tự tạo hồ sơ nhân viên.</p>

    <h3>4. Hồ sơ của tôi</h3>
    <p>Mỗi nhân viên đã có tài khoản vào <strong>Hồ sơ của tôi</strong> (header) để tự cập nhật thông tin cá nhân. Phần công việc (ngày vào làm, trạng thái, ghi chú HR) chỉ HR sửa được.</p>

    <h3>5. Đổi email nhân viên (Super Admin)</h3>
    <p>Chỉ <strong>@AppRoles.Label(AppRoles.SuperAdmin)</strong> được đổi email: <em>Email cá nhân</em> trên hồ sơ NV (khi sửa hồ sơ đã có) và <em>email đăng nhập</em> trên Users. HR Manager khi thêm NV mới vẫn được nhập Email cá nhân lần đầu; sau đó trường khóa. Nhân viên không tự đổi email trên Hồ sơ của tôi. Đổi email đăng nhập trên Users sẽ cập nhật luôn Email cá nhân nếu user đã gắn NV (và ngược lại khi đổi Email cá nhân trên hồ sơ đã có tài khoản).</p>

    <h3>Ai làm gì</h3>
    <ul>
        <li><strong>@AppRoles.Label(AppRoles.HrManager):</strong> thêm / sửa hồ sơ NV (không đổi email sau khi đã tạo).</li>
        <li><strong>@AppRoles.Label(AppRoles.HrStaff):</strong> chỉ xem hồ sơ.</li>
        <li><strong>@AppRoles.Label(AppRoles.SuperAdmin):</strong> cấp tài khoản, gắn NV trên Users, đổi email NV / email đăng nhập.</li>
    </ul>
</section>
}

@if (showCatalog)
{
    <section id="catalog" class="help-section admin-help-section help-section--highlight">
        <h2>Danh mục / Sản phẩm / Dịch vụ / Màu sắc</h2>
        <p>Các màn danh sách dùng pattern modal: <em>Thêm</em> / <em>Sửa</em> mở form trong dialog, không sang trang Edit riêng. Nếu chỉ có quyền xem, danh sách không hiện nút Thêm / Sửa / Xóa / ↑↓.</p>
        <ul>
            <li><strong>Danh mục</strong> - nhóm sản phẩm/dịch vụ; thứ tự hiển thị bằng ↑/↓.</li>
            <li><strong>Sản phẩm</strong> - hàng hóa bán qua giỏ; bật/tắt biến thể size/màu theo từng sản phẩm; ảnh chính + ảnh theo SKU. Ô <em>Đơn giá</em> / giá vốn: nhập số, khi rời ô hiện dạng <code>1.500.000 VNĐ</code>.</li>
            <li><strong>Dịch vụ</strong> - dịch vụ đặt lịch (không qua giỏ).</li>
            <li><strong>Màu sắc</strong> - chỉ <em>Name</em> + <em>Meaning</em> (VI/EN/JA); không có trường Description riêng.</li>
        </ul>
        <p class="muted">Nội dung đa ngôn ngữ: ưu tiên VI; EN/JA có thể để trống (fallback VI). Tiền trên Admin và site khách dùng hậu tố <strong>VNĐ</strong> (không dùng chữ đ).</p>
    </section>
}

@if (showPosts)
{
    <section id="posts" class="help-section admin-help-section">
        <h2>Tin tức &amp; tin tuyển dụng</h2>
        <ul>
            <li><strong>Tin tức</strong> - bài đăng công khai tại <code>/news</code>.</li>
            <li><strong>Tin tuyển dụng</strong> - vị trí hiển thị tại <code>/careers</code>; khách ứng tuyển từ đây.</li>
        </ul>
    </section>
}

@if (showCms)
{
    <section id="cms" class="help-section admin-help-section">
        <h2>CMS &amp; media</h2>
        <ul>
            @if (User.HasPermission(Permissions.CmsPages.View))
            {
                <li><strong>Trang nội dung</strong> - About, Company, Legal, Đại lý (<code>dealers/home</code>), khối nội dung trang chủ, …</li>
            }
            @if (User.HasPermission(Permissions.Menus.Manage) || User.HasPermission(Permissions.HomeSlides.Manage))
            {
                <li><strong>Menus / Slides</strong> - điều hướng và slide trang chủ; sắp xếp bằng ↑/↓.</li>
            }
            @if (User.HasPermission(Permissions.Media.Manage))
            {
                <li><strong>Media</strong> - thư viện ảnh/file dùng cho sản phẩm và CMS.</li>
            }
        </ul>
    </section>
}

@if (showSettings)
{
    <section id="cai-dat" class="help-section admin-help-section">
        <h2>Cài đặt website</h2>
        <ul>
            <li><strong>Phí ship</strong> - theo 34 tỉnh/thành (mã <code>idProvince</code>); miễn phí ship từ ngưỡng cấu hình (hiện 1.000.000 VNĐ trên site khách). Ô phí nhập/hiện theo định dạng tiền VNĐ.</li>
            <li><strong>Users</strong> - tạo/khóa tài khoản, gán <strong>một</strong> vai trò; có thể <em>Gắn nhân viên</em> (hồ sơ NV đã tạo). Đổi vai trò có hiệu lực nhanh (security stamp). Xem thêm mục <a href="#nhan-vien">Nhân viên &amp; tài khoản</a>.</li>
            <li><strong>Thương hiệu &amp; logo</strong> - tên thương hiệu, logo header/footer.</li>
            <li><strong>Email &amp; thông báo</strong> / <strong>Mẫu email</strong> - SMTP và nội dung email đơn hàng, đặt lịch, …</li>
            <li><strong>Kho</strong> - ngưỡng tồn thấp / sắp hết hạn, quản lý vị trí kho.</li>
            <li><strong>Ngân hàng / QR</strong> - thông tin CK hiển thị cho khách khi chọn chuyển khoản.</li>
        </ul>
    </section>
}

<p class="muted admin-help-footnote">
    Hướng dẫn khách hàng (công khai): <a href="/help" target="_blank" rel="noopener">/help</a>.
</p>
