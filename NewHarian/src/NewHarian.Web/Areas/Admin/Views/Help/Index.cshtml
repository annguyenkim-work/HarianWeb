@{
    ViewData["Title"] = "Hướng dẫn";
    var isAdmin = ViewBag.IsAdmin as bool? == true;
}

<div class="admin-page-head">
    <h1>Hướng dẫn sử dụng Admin</h1>
    <p class="muted">Tiếng Việt - dành cho Staff@(isAdmin ? " và Admin" : ""). Phần cấu hình website chỉ hiện với tài khoản Admin.</p>
</div>

<nav class="help-toc admin-help-toc" aria-label="Mục lục">
    <strong>Mục lục</strong>
    <ol>
        <li><a href="#dang-nhap">Đăng nhập</a></li>
        <li><a href="#don-hang">Đơn hàng</a></li>
        <li><a href="#dat-lich">Đặt lịch dịch vụ</a></li>
        <li><a href="#lien-he">Liên hệ (Inquiries)</a></li>
        <li><a href="#dai-ly">Đại lý</a></li>
        <li><a href="#ho-so">Hồ sơ ứng tuyển</a></li>
        @if (isAdmin)
        {
            <li><a href="#catalog">Danh mục / Sản phẩm / Dịch vụ / Màu</a></li>
            <li><a href="#posts">Tin tức &amp; tin tuyển dụng</a></li>
            <li><a href="#cms">CMS &amp; media</a></li>
            <li><a href="#cai-dat">Cài đặt (ship, email, ngân hàng, users)</a></li>
        }
    </ol>
</nav>

<section id="dang-nhap" class="help-section admin-help-section">
    <h2>Đăng nhập</h2>
    <ol class="help-flow">
        <li>
            <span class="help-flow__num">1</span>
            <div>
                <strong>Mở trang đăng nhập</strong>
                <span>Truy cập <code>/admin/login</code> bằng tài khoản Staff hoặc Admin đã được cấp.</span>
            </div>
        </li>
        <li>
            <span class="help-flow__num">2</span>
            <div>
                <strong>Vào Dashboard</strong>
                <span>Sau khi đăng nhập thành công bạn vào khu vực <code>/admin</code>. Menu <em>Vận hành</em> dùng chung; mục <em>Cài đặt website</em> chỉ Admin thấy.</span>
            </div>
        </li>
    </ol>
    <div class="help-callout">
        <strong>Phân quyền</strong>
        <ul>
            <li><strong>Staff:</strong> Đơn hàng, Đặt lịch, Liên hệ, Đại lý, Hồ sơ ứng tuyển.</li>
            <li><strong>Admin:</strong> toàn bộ Staff + catalog, CMS, cấu hình hệ thống.</li>
        </ul>
    </div>
</section>

<section id="don-hang" class="help-section admin-help-section help-section--highlight">
    <h2>Đơn hàng (ưu tiên vận hành)</h2>
    <p>Menu <strong>Đơn hàng</strong> → <code>/admin/Orders</code>. Lọc theo trạng thái / phương thức thanh toán / ngày đặt, tìm theo mã đơn, tên, email, SĐT. Mở icon mắt ở cột Actions để xem <strong>Chi tiết</strong>.</p>

    <h3>Danh sách đơn</h3>
    <figure class="help-figure">
        <img src="~/help/admin/annotated/01-orders-list.png" alt="Danh sách đơn hàng Admin với chú thích lọc và mở chi tiết" width="1024" height="639" loading="lazy" />
        <figcaption>① Lọc / tìm đơn · ② Mở Chi tiết · ③ Cột Status</figcaption>
    </figure>

    <h3>Quy trình theo phương thức thanh toán (bước đầu)</h3>
    <div class="help-callout">
        <ul>
            <li><strong>COD</strong>: đơn mới thường ở <code>AwaitingConfirmation</code> → gọi/email xác nhận → ghi <em>Ghi chú nội bộ</em> → nhấn <strong>Xác nhận COD</strong> → <code>Confirmed</code>.</li>
            <li><strong>Chuyển khoản</strong>: đơn ở <code>PendingPayment</code> → đối chiếu đã nhận tiền → <strong>Xác nhận CK</strong> → <code>Confirmed</code>.</li>
        </ul>
        <p class="muted" style="margin:0.5rem 0 0">Ảnh minh họa 2 nút “Xác nhận COD / Xác nhận CK” sẽ bổ sung khi có screenshot.</p>
    </div>

    <h3>Sau khi đã Confirmed — luồng xử lý</h3>
    <p><code>Confirmed</code> → ghi chú nội bộ nếu cần → nhấn <strong>Bắt đầu xử lý</strong> → <code>Processing</code>. Có thể <strong>Hủy đơn</strong> nếu cần.</p>
    <figure class="help-figure">
        <img src="~/help/admin/annotated/02-order-confirmed.png" alt="Chi tiết đơn Confirmed với nút Bắt đầu xử lý" width="1024" height="810" loading="lazy" />
        <figcaption>① Status Confirmed · ② Ghi chú nội bộ · ③ Bắt đầu xử lý</figcaption>
    </figure>

    <p><code>Processing</code> → khi đã chuyển giao vận, nhấn <strong>Đã giao vận</strong> → <code>Shipped</code>. (Từ <code>Shipped</code> nhấn <strong>Hoàn thành</strong> → <code>Delivered</code>.)</p>
    <figure class="help-figure">
        <img src="~/help/admin/annotated/03-order-processing.png" alt="Chi tiết đơn Processing với nút Đã giao vận" width="1024" height="801" loading="lazy" />
        <figcaption>① Status Processing · ② Đã giao vận</figcaption>
    </figure>

    <p>Khi đơn <code>Delivered</code>, không còn nút đổi trạng thái — dùng phần <strong>Lịch sử cập nhật</strong> để đối chiếu ai đã thao tác khi nào.</p>
    <figure class="help-figure">
        <img src="~/help/admin/annotated/04-order-delivered.png" alt="Chi tiết đơn Delivered với lịch sử cập nhật" width="1024" height="802" loading="lazy" />
        <figcaption>① Status Delivered · ② Lịch sử cập nhật</figcaption>
    </figure>

    <p><strong>Hủy đơn:</strong> khả dụng khi đơn còn ở AwaitingConfirmation / PendingPayment / Confirmed / Processing.</p>
    <p class="muted">Đơn mới (web, tạo tay, import) bắt buộc <strong>CCCD</strong> (9 hoặc 12 chữ số) để xuất hóa đơn. Đơn <strong>đại lý</strong> chỉ tạo tay: chọn loại khách Đại lý, prefill hồ sơ, chiết khấu % có thể sửa trên đơn (giảm tổng tiền).</p>
    <p class="muted">Gợi ý: luôn cập nhật <em>Ghi chú nội bộ</em> (đã gọi lúc nào, khách xác nhận gì) trước khi đổi trạng thái.</p>
</section>

<section id="dat-lich" class="help-section admin-help-section">
    <h2>Đặt lịch dịch vụ</h2>
    <p>Menu <strong>Đặt lịch</strong> → <code>/admin/ServiceBookings</code>. Lọc theo trạng thái, mở <strong>Chi tiết</strong>, cập nhật Status + <em>Ghi chú nội bộ</em> → <strong>Lưu</strong>.</p>
    <ul>
        <li><code>New</code> - vừa nhận từ website</li>
        <li><code>Confirmed</code> - đã liên hệ / chốt lịch với khách</li>
        <li><code>Completed</code> - đã hoàn thành dịch vụ</li>
        <li><code>Cancelled</code> - hủy</li>
    </ul>
</section>

<section id="lien-he" class="help-section admin-help-section">
    <h2>Liên hệ (Inquiries)</h2>
    <p>Menu <strong>Liên hệ</strong> → <code>/admin/Inquiries</code>. Đây là tin nhắn từ trang Liên hệ của khách. Lọc theo trạng thái, tìm theo tên / email / SĐT.</p>

    <h3>Danh sách</h3>
    <figure class="help-figure">
        <img src="~/help/admin/annotated/07-inquiries-list.png" alt="Danh sách liên hệ Admin với chú thích lọc và mở chi tiết" width="1024" height="639" loading="lazy" />
        <figcaption>① Lọc / tìm · ② Mở Chi tiết · ③ Cột Status</figcaption>
    </figure>

    <h3>Chi tiết &amp; xử lý</h3>
    <p>Mở icon mắt → đọc nội dung, đổi <strong>Status</strong>, ghi <em>Ghi chú</em> → nhấn <strong>Lưu</strong>.</p>
    <ul>
        <li><code>New</code> — vừa nhận</li>
        <li><code>InProgress</code> — đang xử lý / đã liên hệ</li>
        <li><code>Resolved</code> — đã xử lý xong</li>
        <li><code>Closed</code> — đóng</li>
    </ul>
    <figure class="help-figure">
        <img src="~/help/admin/annotated/08-inquiries-detail.png" alt="Modal chi tiết inquiry với Status và Lưu" width="1024" height="639" loading="lazy" />
        <figcaption>① Nội dung tin nhắn · ② Đổi Status · ③ Ghi chú · ④ Lưu</figcaption>
    </figure>
</section>

<section id="dai-ly" class="help-section admin-help-section">
    <h2>Đại lý</h2>
    <p>Menu <strong>Đại lý</strong> → <code>/admin/Dealers</code>. Khách đăng ký trên web ở trạng thái <code>Pending</code>. Staff/Admin mở chi tiết: nhập <strong>% chiết khấu</strong> → <strong>Duyệt</strong>, hoặc <strong>Từ chối</strong>. Đại lý đã duyệt: sửa % / ghi chú nội bộ. Nút <strong>Thêm</strong> tạo thẳng đại lý <code>Approved</code> (không qua form web).</p>
    <p>Đơn xuất đại lý: <strong>Đơn hàng → Thêm đơn</strong> → loại khách <em>Đại lý</em> → chọn hồ sơ đã duyệt (prefill tên/SĐT/email/địa chỉ) → nhập CCCD → có thể đổi % trên đơn. Website không cho đại lý tự đặt hàng.</p>
</section>

<section id="ho-so" class="help-section admin-help-section">
    <h2>Hồ sơ ứng tuyển</h2>
    <p>Menu <strong>Hồ sơ ứng tuyển</strong> → <code>/admin/Applications</code> (tiêu đề trang: <em>Hồ sơ tuyển dụng</em>). Lọc theo trạng thái / tin tuyển dụng, tìm theo tên, email, SĐT.</p>

    <h3>Danh sách hồ sơ</h3>
    <figure class="help-figure">
        <img src="~/help/admin/annotated/05-applications-list.png" alt="Danh sách hồ sơ tuyển dụng với chú thích lọc và mở chi tiết" width="1024" height="639" loading="lazy" />
        <figcaption>① Lọc / tìm hồ sơ · ② Có CV / xem CV · ③ Mở Chi tiết</figcaption>
    </figure>

    <h3>Chi tiết &amp; xử lý</h3>
    <p>Trong modal: xem vị trí ứng tuyển, thông tin ứng viên, tải CV (nếu có). Đổi <strong>Status</strong>, ghi <em>Ghi chú</em>, rồi nhấn <strong>Lưu</strong>.</p>
    <ul>
        <li><code>New</code> — vừa nhận</li>
        <li><code>Reviewing</code> — đang xem xét</li>
        <li><code>Accepted</code> — đạt / tiếp nhận</li>
        <li><code>Rejected</code> — không phù hợp</li>
        <li><code>Closed</code> — đóng hồ sơ</li>
    </ul>
    <figure class="help-figure">
        <img src="~/help/admin/annotated/06-applications-detail.png" alt="Modal chi tiết hồ sơ ứng tuyển với Status và Lưu" width="1024" height="639" loading="lazy" />
        <figcaption>① Thông tin ứng viên + CV · ② Đổi Status · ③ Ghi chú · ④ Lưu</figcaption>
    </figure>
</section>

@if (isAdmin)
{
    <section id="catalog" class="help-section admin-help-section help-section--highlight">
        <h2>Danh mục / Sản phẩm / Dịch vụ / Màu sắc</h2>
        <p>Chỉ <strong>Admin</strong>. Các màn danh sách dùng pattern modal: <em>Thêm</em> / <em>Sửa</em> mở form trong dialog, không sang trang Edit riêng.</p>
        <ul>
            <li><strong>Danh mục</strong> - nhóm sản phẩm/dịch vụ; thứ tự hiển thị bằng ↑/↓.</li>
            <li><strong>Sản phẩm</strong> - hàng hóa bán qua giỏ; bật/tắt biến thể size/màu theo từng sản phẩm; ảnh chính + ảnh theo SKU.</li>
            <li><strong>Dịch vụ</strong> - dịch vụ đặt lịch (không qua giỏ).</li>
            <li><strong>Màu sắc</strong> - chỉ <em>Name</em> + <em>Meaning</em> (VI/EN/JA); không có trường Description riêng.</li>
        </ul>
        <p class="muted">Nội dung đa ngôn ngữ: ưu tiên VI; EN/JA có thể để trống (fallback VI).</p>
    </section>

    <section id="posts" class="help-section admin-help-section">
        <h2>Tin tức &amp; tin tuyển dụng</h2>
        <ul>
            <li><strong>Tin tức</strong> - bài đăng công khai tại <code>/news</code>.</li>
            <li><strong>Tin tuyển dụng</strong> - vị trí hiển thị tại <code>/careers</code>; khách ứng tuyển từ đây.</li>
        </ul>
    </section>

    <section id="cms" class="help-section admin-help-section">
        <h2>CMS &amp; media</h2>
        <ul>
            <li><strong>Trang nội dung</strong> - About, Company, Legal, khối nội dung trang chủ, …</li>
            <li><strong>Menus / Slides</strong> - điều hướng và slide trang chủ; sắp xếp bằng ↑/↓.</li>
            <li><strong>Media</strong> - thư viện ảnh/file dùng cho sản phẩm và CMS.</li>
        </ul>
    </section>

    <section id="cai-dat" class="help-section admin-help-section">
        <h2>Cài đặt website</h2>
        <ul>
            <li><strong>Phí ship</strong> - theo tỉnh/thành; miễn phí ship từ ngưỡng cấu hình (hiện 1.000.000đ trên site khách).</li>
            <li><strong>Users</strong> - tạo/khóa tài khoản Admin/Staff.</li>
            <li><strong>Thương hiệu &amp; logo</strong> - tên thương hiệu, logo header/footer.</li>
            <li><strong>Email &amp; thông báo</strong> / <strong>Mẫu email</strong> - SMTP và nội dung email đơn hàng, đặt lịch, …</li>
            <li><strong>Ngân hàng / QR</strong> - thông tin CK hiển thị cho khách khi chọn chuyển khoản.</li>
        </ul>
    </section>
}

<p class="muted admin-help-footnote">
    Hướng dẫn khách hàng (công khai): <a href="/help" target="_blank" rel="noopener">/help</a>.
    @(isAdmin ? "" : "Một số mục cấu hình bị ẩn vì tài khoản của bạn là Staff - liên hệ Admin nếu cần.")
</p>
