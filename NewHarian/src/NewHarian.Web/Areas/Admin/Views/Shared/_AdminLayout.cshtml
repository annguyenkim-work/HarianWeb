@using NewHarian.Application.Cms
@inject ISiteChromeCache Chrome
@{
    var brandMap = await Chrome.GetSettingsAsync();
    var brandName = brandMap.GetValueOrDefault("company.brand");
    if (string.IsNullOrWhiteSpace(brandName)) brandName = "Harian";
    var companyName = brandMap.GetValueOrDefault("company.name");
    if (string.IsNullOrWhiteSpace(companyName)) companyName = brandName;
    var logoUrl = brandMap.GetValueOrDefault("company.logo") ?? "";
    var navMenu = AdminNavigation.For(User);
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentKind = Context.Request.Query["kind"].ToString();
    var narrow = string.Equals(ViewData["AdminWidth"] as string, "narrow", StringComparison.Ordinal);
    var onDashboard = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @brandName Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Noto+Sans+JP:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
</head>
<body class="admin-body@(User.Identity?.IsAuthenticated == true ? " admin-body--authed" : "")">
    <header class="admin-header">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <button type="button" class="admin-menu-btn" id="admin-menu-btn" aria-controls="admin-sidebar" aria-expanded="false" aria-label="Mở menu">
                <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>
        }
        <a class="admin-brand" asp-area="Admin" asp-controller="Home" asp-action="Index" title="@companyName">
            @if (!string.IsNullOrWhiteSpace(logoUrl))
            {
                <img src="@logoUrl" alt="@brandName" class="admin-brand__logo" />
            }
            else
            {
                <span class="admin-brand__text">@brandName</span>
            }
            <span class="admin-brand__badge">Admin</span>
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="admin-header__end">
                <div class="admin-notify" id="admin-notify">
                    <button type="button" class="admin-notify__btn" id="admin-notify-btn" aria-label="Thông báo" aria-expanded="false" aria-haspopup="true" title="Thông báo">
                        <i class="fa-solid fa-bell" aria-hidden="true"></i>
                        <span class="admin-notify__badge" id="admin-notify-badge" hidden>0</span>
                    </button>
                    <div class="admin-notify__panel" id="admin-notify-panel" hidden>
                        <div class="admin-notify__head">
                            <strong>Thông báo</strong>
                            <button type="button" class="btn-link" id="admin-notify-read-all">Đánh dấu đã đọc</button>
                        </div>
                        <ul class="admin-notify__list" id="admin-notify-list"></ul>
                        <p class="admin-notify__empty muted" id="admin-notify-empty" hidden>Không có thông báo</p>
                    </div>
                </div>
                @if (User.HasPermission(Permissions.MyProfile.Edit))
                {
                    <a class="btn-link" asp-area="Admin" asp-controller="MyProfile" asp-action="Index" id="admin-my-profile">Hồ sơ của tôi</a>
                }
                <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-link">Đăng xuất</button>
                </form>
            </div>
        }
    </header>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <aside class="admin-sidebar" id="admin-sidebar" aria-label="Menu quản trị">
            <div class="admin-sidebar__panel">
                <div class="admin-sidebar__top">
                    <p class="admin-sidebar__title">Menu</p>
                    <button type="button" class="admin-sidebar__close" id="admin-sidebar-close" aria-label="Đóng menu">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                </div>
                <nav class="admin-sidebar__nav">
                    @if (onDashboard)
                    {
                        <a class="admin-nav__link" asp-area="Admin" asp-controller="Home" asp-action="Index" aria-current="page" title="Tổng quan">
                            <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
                            <span class="admin-nav__text">Tổng quan</span>
                        </a>
                    }
                    else
                    {
                        <a class="admin-nav__link" asp-area="Admin" asp-controller="Home" asp-action="Index" title="Tổng quan">
                            <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
                            <span class="admin-nav__text">Tổng quan</span>
                        </a>
                    }
                    @{ var sectionIndex = 0; }
                    @foreach (var navSection in navMenu.Sections)
                    {
                        var open = navSection.Children.Any(item => AdminNavigation.IsCurrent(item, currentController, currentAction, currentKind));
                        var subId = $"admin-nav-sub-{sectionIndex++}";
                        var expanded = open ? "true" : "false";
                        <div class="admin-nav__group@(open ? " is-open is-current" : "")">
                            <button type="button" class="admin-nav__link" aria-expanded="@expanded" aria-controls="@subId" title="@navSection.Label">
                                <i class="fa-solid @navSection.Icon" aria-hidden="true"></i>
                                <span class="admin-nav__text">@navSection.Label</span>
                                <i class="fa-solid fa-chevron-down admin-nav__chevron" aria-hidden="true"></i>
                            </button>
                            <div class="admin-nav__sub" id="@subId">
                                @foreach (var item in navSection.Children)
                                {
                                    var current = AdminNavigation.IsCurrent(item, currentController, currentAction, currentKind);
                                    if (current)
                                    {
                                        <a class="admin-nav__sublink" asp-area="Admin" asp-controller="@item.Controller" asp-action="@item.Action" asp-all-route-data="item.RouteValues" aria-current="page">@item.Label</a>
                                    }
                                    else
                                    {
                                        <a class="admin-nav__sublink" asp-area="Admin" asp-controller="@item.Controller" asp-action="@item.Action" asp-all-route-data="item.RouteValues">@item.Label</a>
                                    }
                                }
                            </div>
                        </div>
                    }
                    @if (navMenu.Footer.Count > 0)
                    {
                        <div class="admin-nav__footer">
                            @foreach (var link in navMenu.Footer)
                            {
                                var current = AdminNavigation.IsCurrent(link.Item, currentController, currentAction, currentKind);
                                if (current)
                                {
                                    <a class="admin-nav__link" asp-area="Admin" asp-controller="@link.Item.Controller" asp-action="@link.Item.Action" asp-all-route-data="@link.Item.RouteValues" aria-current="page" title="@link.Item.Label">
                                        <i class="fa-solid @link.Icon" aria-hidden="true"></i>
                                        <span class="admin-nav__text">@link.Item.Label</span>
                                    </a>
                                }
                                else
                                {
                                    <a class="admin-nav__link" asp-area="Admin" asp-controller="@link.Item.Controller" asp-action="@link.Item.Action" asp-all-route-data="@link.Item.RouteValues" title="@link.Item.Label">
                                        <i class="fa-solid @link.Icon" aria-hidden="true"></i>
                                        <span class="admin-nav__text">@link.Item.Label</span>
                                    </a>
                                }
                            }
                        </div>
                    }
                </nav>
            </div>
        </aside>
        <div class="admin-nav-backdrop" id="admin-nav-backdrop" hidden></div>
    }

    <main class="admin-main@(narrow ? " admin-main--narrow" : "")">
        @RenderBody()
    </main>
    <dialog id="admin-confirm" class="modal">
        <div class="modal__box">
            <h2>Xác nhận</h2>
            <p id="admin-confirm-text"></p>
            <div class="modal__actions">
                <button type="button" class="btn-secondary" data-confirm-cancel>Hủy</button>
                <button type="button" class="btn-primary" data-confirm-ok>Đồng ý</button>
            </div>
        </div>
    </dialog>
    <partial name="_AdminToasts" />
    <script src="~/js/money-format.js" asp-append-version="true"></script>
    <script src="~/js/admin-toast.js" asp-append-version="true"></script>
    <script src="~/js/admin-lang-tabs.js" asp-append-version="true"></script>
    <script src="~/js/admin-richtext.js" asp-append-version="true"></script>
    <script src="~/js/admin-fetch-guard.js" asp-append-version="true"></script>
    <script src="~/lib/microsoft/signalr/signalr.min.js" asp-append-version="true"></script>
    <script>
    (() => {
      const menuBtn = document.getElementById('admin-menu-btn');
      const sidebar = document.getElementById('admin-sidebar');
      const backdrop = document.getElementById('admin-nav-backdrop');
      const closeBtn = document.getElementById('admin-sidebar-close');
      function setNavOpen(open) {
        document.body.classList.toggle('admin-body--nav-open', open);
        if (backdrop) backdrop.hidden = !open;
        menuBtn?.setAttribute('aria-expanded', open ? 'true' : 'false');
      }
      menuBtn?.addEventListener('click', () => setNavOpen(!document.body.classList.contains('admin-body--nav-open')));
      closeBtn?.addEventListener('click', () => setNavOpen(false));
      backdrop?.addEventListener('click', () => setNavOpen(false));
      sidebar?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setNavOpen(false)));
      sidebar?.querySelectorAll('.admin-nav__group > .admin-nav__link').forEach(btn => {
        btn.addEventListener('click', () => {
          const group = btn.parentElement;
          const willOpen = !group.classList.contains('is-open');
          sidebar.querySelectorAll('.admin-nav__group.is-open').forEach(other => {
            if (other === group) return;
            other.classList.remove('is-open');
            other.querySelector('.admin-nav__link')?.setAttribute('aria-expanded', 'false');
          });
          group.classList.toggle('is-open', willOpen);
          btn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
        });
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && document.body.classList.contains('admin-body--nav-open')) setNavOpen(false);
      });

      const confirmDialog = document.getElementById('admin-confirm');
      const confirmText = document.getElementById('admin-confirm-text');
      window.adminConfirm = function (message) {
        if (!confirmDialog || typeof confirmDialog.showModal !== 'function')
          return Promise.resolve(window.confirm(message));
        confirmText.textContent = message || '';
        confirmDialog.showModal();
        return new Promise(resolve => {
          const okBtn = confirmDialog.querySelector('[data-confirm-ok]');
          const cancelBtn = confirmDialog.querySelector('[data-confirm-cancel]');
          let result = false;
          let settled = false;
          const finish = (value) => {
            if (settled) return;
            settled = true;
            okBtn?.removeEventListener('click', onOk);
            cancelBtn?.removeEventListener('click', onCancel);
            confirmDialog.removeEventListener('close', onClose);
            resolve(value);
          };
          const onOk = () => { result = true; confirmDialog.close(); };
          const onCancel = () => { result = false; confirmDialog.close(); };
          const onClose = () => finish(result);
          okBtn?.addEventListener('click', onOk);
          cancelBtn?.addEventListener('click', onCancel);
          confirmDialog.addEventListener('close', onClose);
        });
      };
      document.addEventListener('submit', (e) => {
        const form = e.target;
        if (!(form instanceof HTMLFormElement)) return;
        const msg = form.dataset.confirm;
        if (!msg || form.dataset.confirmed === '1') {
          if (form.dataset.confirmed === '1') delete form.dataset.confirmed;
          return;
        }
        e.preventDefault();
        e.stopPropagation();
        window.adminConfirm(msg).then(ok => {
          if (!ok) return;
          form.dataset.confirmed = '1';
          if (typeof form.requestSubmit === 'function') form.requestSubmit();
          else form.submit();
        });
      }, true);

      const root = document.getElementById('admin-notify');
      if (!root || typeof signalR === 'undefined') return;
      const btn = document.getElementById('admin-notify-btn');
      const panel = document.getElementById('admin-notify-panel');
      const badge = document.getElementById('admin-notify-badge');
      const list = document.getElementById('admin-notify-list');
      const empty = document.getElementById('admin-notify-empty');
      const readAll = document.getElementById('admin-notify-read-all');
      const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
        || document.querySelector('#admin-notify ~ form input[name="__RequestVerificationToken"]')?.value
        || document.querySelector('.admin-header__end input[name="__RequestVerificationToken"]')?.value;

      const silent = { 'X-Admin-Silent': '1' };

      function antiForgeryFormData() {
        const fd = new FormData();
        const t = document.querySelector('.admin-header__end input[name="__RequestVerificationToken"]')?.value;
        if (t) fd.append('__RequestVerificationToken', t);
        return fd;
      }

      function setBadge(n) {
        if (n > 0) {
          badge.hidden = false;
          badge.textContent = n > 99 ? '99+' : String(n);
        } else {
          badge.hidden = true;
          badge.textContent = '0';
        }
      }

      function relTime(iso) {
        const d = new Date(iso);
        const sec = Math.max(0, Math.floor((Date.now() - d.getTime()) / 1000));
        if (sec < 60) return 'vừa xong';
        if (sec < 3600) return Math.floor(sec / 60) + ' phút trước';
        if (sec < 86400) return Math.floor(sec / 3600) + ' giờ trước';
        return d.toLocaleString();
      }

      function renderItems(items) {
        list.innerHTML = '';
        if (!items || !items.length) {
          empty.hidden = false;
          return;
        }
        empty.hidden = true;
        items.forEach(it => {
          const li = document.createElement('li');
          li.className = 'admin-notify__item' + (it.isRead ? '' : ' is-unread');
          li.innerHTML = `<a href="${it.url}" data-id="${it.id}"><span class="admin-notify__title">${it.title}</span><span class="admin-notify__time">${relTime(it.createdAt)}</span></a>`;
          list.appendChild(li);
        });
      }

      async function refreshCount() {
        try {
          const res = await fetch('/admin/Notifications/UnreadCount', { headers: silent });
          if (!res.ok) return;
          const data = await res.json();
          setBadge(data.count || 0);
        } catch { /* ignore */ }
      }

      async function refreshList() {
        try {
          const res = await fetch('/admin/Notifications?take=20', { headers: silent });
          if (!res.ok) return;
          const items = await res.json();
          renderItems(items);
        } catch { /* ignore */ }
      }

      btn?.addEventListener('click', async (e) => {
        e.stopPropagation();
        const open = panel.hidden;
        panel.hidden = !open;
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) await refreshList();
      });
      panel?.addEventListener('click', e => e.stopPropagation());
      document.addEventListener('click', () => {
        panel.hidden = true;
        btn?.setAttribute('aria-expanded', 'false');
      });

      list?.addEventListener('click', async (e) => {
        const a = e.target.closest('a[data-id]');
        if (!a) return;
        e.preventDefault();
        const id = a.getAttribute('data-id');
        const fd = antiForgeryFormData();
        fd.append('id', id);
        try {
          await fetch('/admin/Notifications/MarkRead', { method: 'POST', body: fd, headers: silent });
        } catch { /* ignore */ }
        location.href = a.getAttribute('href');
      });

      readAll?.addEventListener('click', async () => {
        try {
          await fetch('/admin/Notifications/MarkAllRead', { method: 'POST', body: antiForgeryFormData() });
          setBadge(0);
          await refreshList();
        } catch { /* ignore */ }
      });

      let hubOk = false;
      try {
        const connection = new signalR.HubConnectionBuilder()
          .withUrl('/admin/hubs/notifications')
          .withAutomaticReconnect()
          .build();
        connection.on('notificationCreated', () => {
          refreshCount();
          if (!panel.hidden) refreshList();
        });
        connection.start().then(() => { hubOk = true; }).catch(() => { hubOk = false; });
      } catch { hubOk = false; }

      refreshCount();
      setInterval(() => { if (!hubOk) refreshCount(); }, 45000);
    })();
    </script>
    <script src="~/js/address-fields.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
