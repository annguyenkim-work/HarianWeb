@model IReadOnlyList<NewHarian.Application.Admin.StatusHistoryItemDto>
@{
    var items = Model ?? Array.Empty<NewHarian.Application.Admin.StatusHistoryItemDto>();
}
<section class="status-history" aria-label="Lịch sử cập nhật">
    <h3 class="status-history__title">Lịch sử cập nhật</h3>
    @if (items.Count == 0)
    {
        <p class="muted status-history__empty">Chưa có lịch sử.</p>
    }
    else
    {
        <ol class="status-history__list">
        @foreach (var h in items)
        {
            var actor = string.IsNullOrWhiteSpace(h.ActorName)
                ? h.ActorType
                : $"{h.ActorType} · {h.ActorName}";
            <li class="status-history__item">
                <div class="status-history__marker" aria-hidden="true"></div>
                <div class="status-history__body">
                    <p class="status-history__message">@h.MessageVi</p>
                    <div class="status-history__meta">
                        <time datetime="@h.CreatedAt.ToString("o")">@h.CreatedAt.ToLocalTime().ToString("g")</time>
                        <span class="status-history__actor">@actor</span>
                    </div>
                </div>
            </li>
        }
        </ol>
    }
</section>
