@model NewHarian.Application.Catalog.CategorySaveRequest
<form asp-area="Admin" asp-controller="Categories" asp-action="Save" method="post" enctype="multipart/form-data" id="category-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ImageUrl" />
    <h2>@(Model.Id.HasValue ? "Sửa danh mục" : "Thêm danh mục")</h2>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-grid">
        <label><input asp-for="IsActive" /> Đang hiện</label>
        <label><input asp-for="ShowOnHome" /> Hiện trên trang chủ</label>
        <label class="full">Ảnh danh mục
            <input type="file" name="imageFile" id="category-image-input" accept="image/jpeg,image/png,image/webp,image/gif" class="form-control" />
            <span id="category-image-status" class="muted"></span>
        </label>
        <p class="full img-size-hint"><strong>Kích thước đề xuất:</strong> 600×400 px (ngang ~3:2). JPG/PNG/WEBP/GIF. Sau khi chọn ảnh, kéo khung 3:2 để chọn vùng hiển thị trước khi lưu.</p>
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <div class="full" id="category-image-preview-wrap">
                <p class="muted">Ảnh hiện tại:</p>
                <img id="category-image-preview" src="@Model.ImageUrl" alt="" class="img-preview" />
            </div>
        }
        else
        {
            <div class="full" id="category-image-preview-wrap" hidden>
                <p class="muted">Ảnh sau khi cắt:</p>
                <img id="category-image-preview" alt="" class="img-preview" />
            </div>
        }
    </div>
    <div class="lang-tabs" data-lang-tabs>
        <partial name="_LangTabBar" model="@("category-lang")" />
        <p class="lang-tabs__hint">Tên cả ba ngôn ngữ đều bắt buộc. Chấm đỏ là tab còn thiếu.</p>
        <div class="lang-tabs__panel is-active" id="category-lang-panel-vi" role="tabpanel" aria-labelledby="category-lang-tab-vi" data-lang-panel="vi">
            <div class="lang-tabs__fields">
                <label>Tên * <input asp-for="NameVi" class="form-control" required id="name-vi" /></label>
                <label>Mô tả <textarea asp-for="DescVi" class="form-control" rows="2"></textarea></label>
            </div>
        </div>
        <div class="lang-tabs__panel" id="category-lang-panel-en" role="tabpanel" aria-labelledby="category-lang-tab-en" data-lang-panel="en" hidden>
            <div class="lang-tabs__fields">
                <label>Tên * <input asp-for="NameEn" class="form-control" required /></label>
                <label>Mô tả <textarea asp-for="DescEn" class="form-control" rows="2"></textarea></label>
            </div>
        </div>
        <div class="lang-tabs__panel" id="category-lang-panel-ja" role="tabpanel" aria-labelledby="category-lang-tab-ja" data-lang-panel="ja" hidden>
            <div class="lang-tabs__fields">
                <label>Tên * <input asp-for="NameJa" class="form-control" required /></label>
                <label>Mô tả <textarea asp-for="DescJa" class="form-control" rows="2"></textarea></label>
            </div>
        </div>
    </div>
    <div class="modal__actions">
        <button type="button" data-close class="btn-secondary">Hủy</button>
        <button type="submit" class="btn-primary">Lưu</button>
    </div>
</form>
