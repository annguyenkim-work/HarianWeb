@model IReadOnlyList<NewHarian.Application.Catalog.AdminCategoryListItemDto>
@using NewHarian.Web.Areas.Admin
@{
    ViewData["Title"] = "Danh mục";
    Layout = "_AdminLayout";
    var pager = ViewBag.Pager as AdminPagerModel;
    var offset = pager?.Offset ?? 0;
    var total = pager?.TotalCount ?? Model.Count;
}

<div class="admin-toolbar">
    <h1>Danh mục</h1>
    <button type="button" class="btn-icon btn-primary" id="btn-add-cat" title="Add new" aria-label="Add new"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
</div>

@if (TempData["Success"] is string ok) { <p class="text-success">@ok</p> }
@if (TempData["Error"] is string err) { <p class="text-danger">@err</p> }

<p class="muted">Danh mục mới tự động xếp cuối danh sách. Dùng ↑/↓ để đổi thứ tự hiển thị.</p>

<table class="data-table">
    <thead>
        <tr><th>Ảnh</th><th>Tên</th><th class="sort-cell">Thứ tự hiển thị</th><th>Home</th><th>Active</th><th></th></tr>
    </thead>
    <tbody>
    @for (var i = 0; i < Model.Count; i++)
    {
        var c = Model[i];
        var abs = offset + i;
        <tr>
            <td>
                @if (!string.IsNullOrWhiteSpace(c.ImageUrl))
                {
                    <img src="@c.ImageUrl" alt="" style="width:48px;height:48px;object-fit:cover" />
                }
                else { <span class="muted">-</span> }
            </td>
            <td>@c.NameVi</td>
            <td class="sort-cell">
                <div class="sort-controls">
                    <span class="sort-controls__pos">@(abs + 1)</span>
                    <form asp-action="Move" method="post" class="sort-controls__move">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@c.Id" />
                        <button name="direction" value="-1" type="submit" class="btn-icon" title="Up" aria-label="Up" @(abs == 0 ? "disabled" : null)><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button>
                        <button name="direction" value="1" type="submit" class="btn-icon" title="Down" aria-label="Down" @(abs >= total - 1 ? "disabled" : null)><i class="fa-solid fa-arrow-down" aria-hidden="true"></i></button>
                    </form>
                </div>
            </td>
            <td>@(c.ShowOnHome ? "✓" : "-")</td>
            <td>@(c.IsActive ? "✓" : "-")</td>
            <td class="actions">
                <button type="button" class="btn-icon btn-edit-cat" data-id="@c.Id" title="Update" aria-label="Update"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>
                @if (c.IsActive)
                {
                    <form asp-action="Delete" method="post" class="inline" onsubmit="return confirm('Vô hiệu hóa danh mục này? (không xóa dữ liệu)');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@c.Id" />
                        <button type="submit" class="btn-icon btn-icon--danger" title="Delete" aria-label="Delete"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

<partial name="_AdminPager" />

<dialog id="cat-modal" class="modal">
    <div class="modal__box modal__box--wide" id="cat-modal-body"></div>
</dialog>

<dialog id="cat-image-crop-modal" class="modal">
    <div class="modal__box image-crop-modal__panel">
        <h2>Chọn vùng hiển thị</h2>
        <p class="muted">Kéo / phóng khung ngang 3:2. Ảnh sẽ được lưu ở kích thước 600×400 px.</p>
        <div class="image-crop-modal__stage">
            <img id="cat-image-crop-target" alt="Ảnh cần cắt" />
        </div>
        <div class="modal__actions image-crop-modal__actions">
            <button type="button" class="btn-secondary" id="cat-image-crop-cancel">Hủy</button>
            <button type="button" class="btn-primary" id="cat-image-crop-apply">Áp dụng</button>
        </div>
    </div>
</dialog>

@section Scripts {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css" />
<script src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"></script>
<script>
(() => {
  const modal = document.getElementById('cat-modal');
  const body = document.getElementById('cat-modal-body');
  const cropModal = document.getElementById('cat-image-crop-modal');
  const cropImg = document.getElementById('cat-image-crop-target');
  const cropApply = document.getElementById('cat-image-crop-apply');
  const cropCancel = document.getElementById('cat-image-crop-cancel');

  let activeCropper = null;
  let activeCropObjectUrl = null;

  function destroyActiveCropper() {
    if (activeCropper) {
      activeCropper.destroy();
      activeCropper = null;
    }
    if (activeCropObjectUrl) {
      URL.revokeObjectURL(activeCropObjectUrl);
      activeCropObjectUrl = null;
    }
    if (cropImg) {
      cropImg.onload = null;
      cropImg.removeAttribute('src');
    }
  }

  function closeCropModal() {
    destroyActiveCropper();
    if (cropModal?.open) cropModal.close();
  }

  function openImageCrop(file, opts = {}) {
    const aspectRatio = opts.aspectRatio ?? (3 / 2);
    const outW = opts.width ?? 600;
    const outH = opts.height ?? 400;
    return new Promise((resolve, reject) => {
      if (!cropModal || !cropImg || !cropApply || !cropCancel) {
        reject(new Error('Thiếu UI crop ảnh.'));
        return;
      }
      if (!window.Cropper) {
        reject(new Error('Cropper chưa tải được.'));
        return;
      }

      let settled = false;
      function finish(fn) {
        if (settled) return;
        settled = true;
        cropApply.onclick = null;
        cropCancel.onclick = null;
        closeCropModal();
        fn();
      }
      function cancel() {
        finish(() => reject(Object.assign(new Error('cancelled'), { cancelled: true })));
      }

      destroyActiveCropper();
      activeCropObjectUrl = URL.createObjectURL(file);
      if (!cropModal.open) cropModal.showModal();
      const startCropper = () => {
        if (activeCropper || settled) return;
        activeCropper = new Cropper(cropImg, {
          aspectRatio,
          viewMode: 1,
          autoCropArea: 1,
          responsive: true,
          background: false,
          movable: true,
          zoomable: true,
          rotatable: false,
          scalable: false
        });
      };
      cropImg.onload = startCropper;
      cropImg.src = activeCropObjectUrl;
      if (cropImg.complete) startCropper();

      cropCancel.onclick = cancel;
      cropApply.onclick = () => {
        if (!activeCropper) return;
        const canvas = activeCropper.getCroppedCanvas({
          width: outW,
          height: outH,
          imageSmoothingEnabled: true,
          imageSmoothingQuality: 'high'
        });
        if (!canvas) {
          cancel();
          return;
        }
        canvas.toBlob((blob) => {
          if (!blob) {
            cancel();
            return;
          }
          const base = (file.name || 'image').replace(/\.[^.]+$/, '') || 'image';
          finish(() => resolve(new File([blob], `${base}.jpg`, { type: 'image/jpeg' })));
        }, 'image/jpeg', 0.92);
      };
    });
  }

  function isCropCancelled(err) {
    return err?.cancelled === true || err?.message === 'cancelled';
  }

  async function openForm(id) {
    const url = id ? `/admin/Categories/Edit/${id}` : '/admin/Categories/Edit';
    const html = await (await fetch(url)).text();
    body.innerHTML = html;
    modal.showModal();
    bindForm();
  }

  function bindForm() {
    const form = body.querySelector('form');
    if (!form) return;

    const imageInput = form.querySelector('#category-image-input, input[name="imageFile"]');
    const status = form.querySelector('#category-image-status');
    imageInput?.addEventListener('change', async () => {
      const file = imageInput.files?.[0];
      if (!file) return;
      if (status) status.textContent = 'Chọn vùng hiển thị...';
      try {
        const cropped = await openImageCrop(file, { aspectRatio: 3 / 2, width: 600, height: 400 });
        const dt = new DataTransfer();
        dt.items.add(cropped);
        imageInput.files = dt.files;
        if (status) status.textContent = 'Đã cắt ảnh 600×400. Bấm Lưu để tải lên.';
        const wrap = form.querySelector('#category-image-preview-wrap');
        const preview = form.querySelector('#category-image-preview');
        if (wrap && preview) {
          wrap.hidden = false;
          const label = wrap.querySelector('.muted');
          if (label) label.textContent = 'Ảnh sau khi cắt:';
          preview.src = URL.createObjectURL(cropped);
        }
      } catch (err) {
        imageInput.value = '';
        if (status) status.textContent = isCropCancelled(err) ? '' : (err.message || 'Crop lỗi');
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const ct = res.headers.get('content-type') || '';
      if (ct.includes('application/json')) {
        const data = await res.json();
        if (data.ok) { location.reload(); return; }
      } else {
        body.innerHTML = await res.text();
        bindForm();
      }
    });
    body.querySelector('[data-close]')?.addEventListener('click', () => modal.close());
  }

  document.getElementById('btn-add-cat').addEventListener('click', () => openForm(null));
  document.querySelectorAll('.btn-edit-cat').forEach(b => b.addEventListener('click', () => openForm(b.dataset.id)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && cropModal?.open) {
      e.stopPropagation();
      cropCancel?.click();
    }
  });
})();
</script>
}
