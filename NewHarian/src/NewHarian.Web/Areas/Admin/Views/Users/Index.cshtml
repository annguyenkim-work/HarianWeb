@model IReadOnlyList<AdminUserListItemDto>
@using NewHarian.Application.Abstractions
@{ ViewData["Title"] = "Users"; Layout = "_AdminLayout"; }

<div class="admin-toolbar">
    <h1>Users</h1>
    <button type="button" class="btn-icon btn-primary" id="btn-add-user" title="Add new" aria-label="Add new"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
</div>


<table class="data-table">
    <thead>
        <tr>
            <th>Email</th>
            <th>Họ tên</th>
            <th>Role</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.Email</td>
            <td>@(string.IsNullOrWhiteSpace(u.FullName) ? "-" : u.FullName)</td>
            <td>
                @(u.Roles.Count == 0 ? "-" : string.Join(", ", u.Roles.Select(AppRoles.Label)))
                @if (UserRolePolicy.NeedsRoleReview(u.Roles))
                {
                    <span class="badge badge--warning" data-role-review>Cần chọn lại role</span>
                }
            </td>
            <td>@(u.IsActive ? "Đang hoạt động" : "Đã khóa")</td>
            <td class="actions">
                <button type="button" class="btn-icon btn-edit-user" data-id="@u.Id" title="Update" aria-label="Update"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>
                @if (User.HasPermission(Permissions.Employees.View))
                {
                    <a class="btn-icon" asp-controller="Employees" asp-action="Index" asp-route-q="@u.Email" title="Hồ sơ nhân viên" aria-label="Hồ sơ nhân viên" data-employee-link><i class="fa-solid fa-id-card" aria-hidden="true"></i></a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

<partial name="_AdminPager" />

<dialog id="user-modal" class="modal">
    <div class="modal__box modal__box--wide" id="user-modal-body"></div>
</dialog>

@section Scripts {
<script>
(() => {
  const modal = document.getElementById('user-modal');
  const body = document.getElementById('user-modal-body');

  async function openForm(id) {
    const url = id ? `/admin/Users/Edit/${encodeURIComponent(id)}` : '/admin/Users/Edit';
    body.innerHTML = await (await fetch(url)).text();
    modal.showModal();
    bindForm();
  }

  function bindForm() {
    const form = body.querySelector('form');
    if (!form) return;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const ct = res.headers.get('content-type') || '';
      if (ct.includes('application/json')) {
        const data = await res.json();
        if (data.ok) { adminToast.reloadWith(data.message); return; }
        adminToast.jsonError(data);
      } else {
        body.innerHTML = await res.text();
        bindForm();
        adminToast.formErrors(body);
      }
    });
    body.querySelector('[data-close]')?.addEventListener('click', () => modal.close());
  }

  document.getElementById('btn-add-user').addEventListener('click', () => openForm(null));
  document.querySelectorAll('.btn-edit-user').forEach(b => b.addEventListener('click', () => openForm(b.dataset.id)));
})();
</script>
}
