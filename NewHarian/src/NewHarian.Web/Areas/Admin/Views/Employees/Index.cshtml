@model IReadOnlyList<NewHarian.Application.Hr.EmployeeListItemDto>
@using NewHarian.Application.Admin
@using NewHarian.Application.Hr
@using NewHarian.Domain.Enums
@{
    ViewData["Title"] = "Nhân viên";
    Layout = "_AdminLayout";
    var canManage = User.HasPermission(Permissions.Employees.Manage);
    var currentStatus = ViewBag.Status as EmployeeStatus?;
    var currentRole = ViewBag.Role as string;
    var roleFilterOptions = UserRolePolicy.Options([]);
}

<div class="admin-toolbar">
    <h1>Nhân viên</h1>
    @if (canManage)
    {
        <button type="button" class="btn-icon btn-primary" id="btn-add-employee" title="Thêm" aria-label="Thêm"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
    }
</div>

<form method="get" class="filter-bar filter-bar--row">
    <select name="status" aria-label="Trạng thái">
        <option value="">Tất cả</option>
        @foreach (var s in EmployeeProfilePolicy.Statuses)
        {
            <option value="@s" selected="@(currentStatus == s)">@EmployeeProfilePolicy.StatusLabel(s)</option>
        }
    </select>
    <select name="role" aria-label="Role">
        <option value="">Tất cả role</option>
        @foreach (var r in roleFilterOptions)
        {
            <option value="@r" selected="@(string.Equals(currentRole, r, StringComparison.Ordinal))">@AppRoles.Label(r)</option>
        }
    </select>
    <input type="search" name="q" value="@ViewBag.Q" placeholder="Tìm mã NV / họ tên / email / role" class="form-control filter-bar__search" />
    <button type="submit" class="btn-secondary filter-bar__submit">Tìm kiếm</button>
</form>

<table class="data-table">
    <thead>
        <tr>
            <th>Mã NV</th>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Role</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var e in Model)
    {
        var openId = e.ProfileId?.ToString() ?? (e.UserId is null ? "" : "u:" + e.UserId);
        <tr data-employee-row="@(string.IsNullOrEmpty(e.Email) ? e.EmployeeCode ?? e.FullName : e.Email)" data-profile-id="@e.ProfileId">
            <td>@(e.EmployeeCode ?? "-")</td>
            <td>
                @(string.IsNullOrWhiteSpace(e.FullName) ? "-" : e.FullName)
                @if (e.ProfileId is null)
                {
                    <span class="badge badge--warning" data-profile-incomplete>Chưa bổ sung hồ sơ</span>
                }
                else if (!e.IsPersonalComplete)
                {
                    <span class="badge badge--warning" data-profile-incomplete>Chưa đủ thông tin cá nhân</span>
                }
                @if (!e.HasAccount && e.ProfileId is not null)
                {
                    <span class="badge" data-no-account>Chưa có tài khoản</span>
                }
            </td>
            <td>@(string.IsNullOrEmpty(e.Email) ? "-" : e.Email)</td>
            <td>@(e.Roles.Count == 0 ? "-" : string.Join(", ", e.Roles.Select(AppRoles.Label)))</td>
            <td>
                @(e.Status is { } st ? EmployeeProfilePolicy.StatusLabel(st) : "-")
                @if (e.HasAccount && !e.IsActive)
                {
                    <span class="badge">Tài khoản đã khóa</span>
                }
            </td>
            <td class="actions">
                @if (!string.IsNullOrEmpty(openId))
                {
                    <button type="button" class="btn-icon btn-open-employee" data-id="@openId" title="@(canManage ? "Sửa" : "Xem")" aria-label="@(canManage ? "Sửa" : "Xem")">
                        <i class="fa-solid @(canManage ? "fa-pen" : "fa-eye")" aria-hidden="true"></i>
                    </button>
                }
            </td>
        </tr>
    }
    @if (Model.Count == 0)
    {
        <tr><td colspan="6" class="muted">Không có nhân viên phù hợp.</td></tr>
    }
    </tbody>
</table>

<partial name="_AdminPager" />

<dialog id="employee-modal" class="modal">
    <div class="modal__box modal__box--wide" id="employee-modal-body"></div>
</dialog>

@section Scripts {
<script>
(() => {
  const modal = document.getElementById('employee-modal');
  const body = document.getElementById('employee-modal-body');

  async function openForm(url) {
    body.innerHTML = await (await fetch(url)).text();
    modal.showModal();
    bindForm();
  }

  function bindForm() {
    body.querySelector('[data-close]')?.addEventListener('click', () => modal.close());
    body.querySelector('[data-grant-account]')?.addEventListener('click', ev => {
      const id = ev.currentTarget.getAttribute('data-grant-account');
      openForm('/admin/Employees/GrantAccount/' + encodeURIComponent(id));
    });
    const form = body.querySelector('form');
    if (!form || !form.querySelector('[type="submit"]')) return;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const ct = res.headers.get('content-type') || '';
      if (ct.includes('application/json')) {
        const data = await res.json();
        if (data.ok) { adminToast.reloadWith(data.message); return; }
        adminToast.jsonError(data);
      } else {
        body.innerHTML = await res.text();
        bindForm();
        adminToast.formErrors(body);
      }
    });
  }

  document.getElementById('btn-add-employee')?.addEventListener('click', () => openForm('/admin/Employees/Create'));
  document.querySelectorAll('.btn-open-employee').forEach(b => b.addEventListener('click', () =>
    openForm('/admin/Employees/Edit/' + encodeURIComponent(b.dataset.id))));
})();
</script>
}
