@model NewHarian.Application.Settings.BrandSettingsDto
@{
    ViewData["Title"] = "Thương hiệu & logo";
    ViewData["AdminWidth"] = "narrow";
    Layout = "_AdminLayout";
}

<div class="admin-toolbar">
    <h1>Thương hiệu &amp; logo</h1>
</div>


<p class="muted">Cấu hình logo và nội dung footer (2 cột: giới thiệu + liên hệ). Trên trang chủ, menu trong suốt nằm trên slide (không dùng ảnh nền menu).</p>

<form method="post" enctype="multipart/form-data" class="form-stack admin-sheet">
    @Html.AntiForgeryToken()
    <label>Tên thương hiệu (header) *
        <input asp-for="BrandName" class="form-control" required placeholder="Harian" />
    </label>
    <label>Tên công ty đầy đủ (copyright footer)
        <input asp-for="CompanyName" class="form-control" placeholder="HARIAN CORPORATION" />
    </label>
    <label>Logo (JPG/PNG/WEBP/SVG)
        <input type="file" name="logoFile" accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml" class="form-control" />
    </label>
    <p class="img-size-hint"><strong>Kích thước đề xuất:</strong> 360×96 px (ngang) hoặc SVG nền trong suốt. Logo hiển thị tối đa ~180×48 px trên header.</p>
    @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
    {
        <div>
            <p>Logo hiện tại:</p>
            <img src="@Model.LogoUrl" alt="Logo" class="brand-logo-preview" />
            <input type="hidden" asp-for="LogoUrl" />
        </div>
    }

    <h2>Giới thiệu footer</h2>
    <div class="lang-tabs" data-lang-tabs>
        <partial name="_LangTabBar" model="@("brand-lang")" />
        <div class="lang-tabs__panel is-active" id="brand-lang-panel-vi" role="tabpanel" aria-labelledby="brand-lang-tab-vi" data-lang-panel="vi">
            <label>Nội dung
                <textarea asp-for="TaglineVi" class="form-control" rows="3" placeholder="Chúng tôi hỗ trợ toàn diện..."></textarea>
            </label>
        </div>
        <div class="lang-tabs__panel" id="brand-lang-panel-en" role="tabpanel" aria-labelledby="brand-lang-tab-en" data-lang-panel="en" hidden>
            <label>Nội dung <textarea asp-for="TaglineEn" class="form-control" rows="3"></textarea></label>
        </div>
        <div class="lang-tabs__panel" id="brand-lang-panel-ja" role="tabpanel" aria-labelledby="brand-lang-tab-ja" data-lang-panel="ja" hidden>
            <label>Nội dung <textarea asp-for="TaglineJa" class="form-control" rows="3"></textarea></label>
        </div>
    </div>

    <h2>Liên hệ (footer)</h2>
    <label>Địa chỉ <input asp-for="Address" class="form-control" /></label>
    <label>Email <input asp-for="Email" class="form-control" type="email" /></label>
    <label>Điện thoại 1 <input asp-for="Phone" class="form-control" /></label>
    <label>Điện thoại 2 <input asp-for="Phone2" class="form-control" /></label>
    <label>Facebook (URL) <input asp-for="FacebookUrl" class="form-control" placeholder="https://facebook.com/..." /></label>
    <label>Instagram (URL) <input asp-for="InstagramUrl" class="form-control" placeholder="https://instagram.com/..." /></label>

    <button type="submit" class="btn-primary">Lưu</button>
</form>

<div class="form-actions form-actions--loose">
@if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
{
    <form asp-action="ClearLogo" method="post" class="inline" data-confirm="Gỡ logo?">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-link">Gỡ logo</button>
    </form>
}
</div>
