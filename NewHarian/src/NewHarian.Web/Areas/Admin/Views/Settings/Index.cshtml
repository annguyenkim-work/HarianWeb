@model NewHarian.Web.Areas.Admin.Controllers.SettingsController.BankSettingsVm
@{
    ViewData["Title"] = "Cài đặt ngân hàng / QR";
    Layout = "_AdminLayout";
}

<div class="admin-toolbar">
    <h1>Thanh toán - Ngân hàng &amp; QR</h1>
</div>

@if (TempData["Success"] is string ok) { <p class="text-success">@ok</p> }

<p class="muted">Ảnh QR dùng trên trang đặt hàng thành công và tra cứu đơn (khi chờ chuyển khoản). Email xác nhận đơn cũng đính kèm QR (nếu có).</p>

<form method="post" enctype="multipart/form-data" class="form-stack" style="max-width:520px">
    @Html.AntiForgeryToken()
    <label>Ngân hàng <input asp-for="BankName" class="form-control" required /></label>
    <label>Số tài khoản <input asp-for="BankAccount" class="form-control" required /></label>
    <label>Chi nhánh <input asp-for="BankBranch" class="form-control" /></label>
    <label>Upload mã QR (JPG/PNG/WEBP)
        <input type="file" name="qrFile" accept="image/jpeg,image/png,image/webp,image/gif" class="form-control" />
    </label>
    <p class="img-size-hint"><strong>Kích thước đề xuất:</strong> 400×400 px (vuông). Nên để QR rõ, nền trắng, không viền trang trí che mã.</p>
    @if (!string.IsNullOrWhiteSpace(Model.BankQr))
    {
        <div>
            <p>QR hiện tại:</p>
            <img src="@Model.BankQr" alt="QR" class="bank-qr-img" />
            <input type="hidden" asp-for="BankQr" />
        </div>
    }
    <button type="submit" class="btn-primary">Lưu</button>
</form>
