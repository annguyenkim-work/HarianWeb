@model NewHarian.Web.Areas.Admin.Controllers.SettingsController.BankSettingsVm
@using NewHarian.Application.Payments
@{
    ViewData["Title"] = "Cài đặt ngân hàng / VietQR";
    Layout = "_AdminLayout";
}

<div class="admin-toolbar">
    <h1>Thanh toán - Ngân hàng &amp; VietQR</h1>
</div>

@if (TempData["Success"] is string ok) { <p class="text-success">@ok</p> }

<p class="muted">Điền BIN + STK (+ tên chủ TK) để sinh VietQR động trên trang thành công đơn, tra cứu đơn và email khách (số tiền + mã đơn).</p>

<form method="post" class="form-stack" style="max-width:520px">
    @Html.AntiForgeryToken()
    <label>Ngân hàng (BIN NAPAS)
        <select asp-for="BankBin" class="form-control" required>
            <option value="">-- Chọn ngân hàng --</option>
            @foreach (var b in VnBankCatalog.All)
            {
                <option value="@b.Bin">@b.DisplayName (@b.Bin)</option>
            }
        </select>
    </label>
    <label>Tên ngân hàng hiển thị <input asp-for="BankName" class="form-control" placeholder="Tự điền khi chọn BIN" /></label>
    <label>Số tài khoản <input asp-for="BankAccount" class="form-control" required /></label>
    <label>Tên chủ tài khoản <input asp-for="AccountHolderName" class="form-control" required placeholder="vd. Nguyen Van A" /></label>
    <label>Chi nhánh <input asp-for="BankBranch" class="form-control" /></label>

    @if (!string.IsNullOrWhiteSpace(Model.VietQrPreviewDataUrl))
    {
        <div>
            <p><strong>Xem trước VietQR</strong> (mẫu 10.000đ / nội dung HAR-ORDER-TEST):</p>
            <img src="@Model.VietQrPreviewDataUrl" alt="VietQR preview" class="bank-qr-img" />
            <p class="muted">Quét thử bằng app ngân hàng để kiểm tra STK trước khi nhận đơn thật.</p>
        </div>
    }

    <button type="submit" class="btn-primary">Lưu</button>
</form>
