@model IReadOnlyList<NewHarian.Application.Catalog.ServiceBookingListItemDto>
@{
    ViewData["Title"] = "Đặt lịch dịch vụ";
    Layout = "_AdminLayout";
    var statuses = Enum.GetValues(typeof(NewHarian.Domain.Enums.ServiceBookingStatus)).Cast<NewHarian.Domain.Enums.ServiceBookingStatus>().ToArray();
    var sort = (string)(ViewBag.Sort ?? "createdAt");
    var dir = (string)(ViewBag.Dir ?? "desc");
    DateOnly? from = ViewBag.From as DateOnly?;
    DateOnly? to = ViewBag.To as DateOnly?;
}

<div class="admin-toolbar">
    <h1>Đặt lịch dịch vụ</h1>
</div>

<form method="get" class="filter-bar filter-bar--row">
    <input type="hidden" name="sort" value="@sort" />
    <input type="hidden" name="dir" value="@dir" />
    <select name="status" aria-label="Trạng thái">
        <option value="">Trạng thái</option>
        @foreach (var s in statuses)
        {
            if (ViewBag.Status as NewHarian.Domain.Enums.ServiceBookingStatus? == s)
            {
                <option value="@s" selected>@s</option>
            }
            else
            {
                <option value="@s">@s</option>
            }
        }
    </select>
    <div class="filter-bar__field">
        <label for="from">Từ ngày hẹn</label>
        <input id="from" type="date" name="from" value="@(from?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="filter-bar__field">
        <label for="to">Đến</label>
        <input id="to" type="date" name="to" value="@(to?.ToString("yyyy-MM-dd"))" />
    </div>
    <input type="search" name="q" value="@ViewBag.Q" placeholder="Mã / tên / email / SĐT" class="form-control filter-bar__search" />
    <button type="submit" class="btn-secondary filter-bar__submit">Tìm kiếm</button>
</form>

@Html.AntiForgeryToken()

<table class="data-table" id="bookings-table">
    <thead>
        <tr>
            <partial name="_SortableTh" model='new SortableThModel { Column = "bookingNumber", Label = "Mã", CurrentSort = sort, CurrentDir = dir }' />
            <partial name="_SortableTh" model='new SortableThModel { Column = "customer", Label = "Khách", CurrentSort = sort, CurrentDir = dir }' />
            <partial name="_SortableTh" model='new SortableThModel { Column = "phone", Label = "SĐT", CurrentSort = sort, CurrentDir = dir }' />
            <partial name="_SortableTh" model='new SortableThModel { Column = "product", Label = "Dịch vụ", CurrentSort = sort, CurrentDir = dir }' />
            <partial name="_SortableTh" model='new SortableThModel { Column = "preferredDate", Label = "Ngày", CurrentSort = sort, CurrentDir = dir }' />
            <partial name="_SortableTh" model='new SortableThModel { Column = "status", Label = "Status", CurrentSort = sort, CurrentDir = dir }' />
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var b in Model)
    {
        <tr data-id="@b.Id">
            <td>@b.BookingNumber</td>
            <td>@b.CustomerName<br /><span class="muted">@b.CustomerEmail</span></td>
            <td>@b.CustomerPhone</td>
            <td>@b.ProductName - @b.VariantLabel</td>
            <td>@b.PreferredDate.ToString("yyyy-MM-dd") @b.PreferredTime</td>
            <td>@b.Status</td>
            <td>
                <button type="button" class="btn-icon btn-detail" data-id="@b.Id" title="Chi tiết" aria-label="Chi tiết"><i class="fa-solid fa-eye" aria-hidden="true"></i></button>
            </td>
        </tr>
    }
    </tbody>
</table>

<partial name="_AdminPager" />

<div id="booking-modal" class="admin-modal" hidden>
    <div class="admin-modal__backdrop" data-close-modal></div>
    <div class="admin-modal__panel modal__box modal__box--order-detail" id="booking-modal-body"></div>
</div>

@section Scripts {
<script>
(() => {
  const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
  const modal = document.getElementById('booking-modal');
  const body = document.getElementById('booking-modal-body');

  const open = async (id) => {
    const res = await fetch('@Url.Action("Detail")?id=' + id);
    body.innerHTML = await res.text();
    modal.hidden = false;
  };

  document.querySelectorAll('.btn-detail').forEach(btn => btn.addEventListener('click', () => open(btn.dataset.id)));
  modal?.addEventListener('click', e => {
    if (e.target.matches('[data-close], [data-close-modal]')) modal.hidden = true;
  });
  body?.addEventListener('click', async e => {
    const btn = e.target.closest('[data-action]');
    if (!btn) return;
    const id = btn.dataset.id;
    const notes = body.querySelector('[name="internalNotes"]')?.value ?? '';
    if (btn.dataset.action !== 'status') return;
    const fd = new FormData();
    fd.append('__RequestVerificationToken', token);
    fd.append('id', id);
    fd.append('internalNotes', notes);
    fd.append('status', btn.dataset.status);
    const res = await fetch('@Url.Action("UpdateStatus")', { method: 'POST', body: fd });
    const json = await res.json();
    if (json.ok) location.reload();
    else alert(json.error || 'Lỗi');
  });
})();
</script>
}
