@model NewHarian.Application.Dashboard.AdminDashboardDto
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    var showRevenue = ViewBag.ShowRevenue == true;
    var k = Model.Kpis;
    var startVal = Model.Range.Start.ToString("yyyy-MM-dd");
    var endVal = Model.Range.End.ToString("yyyy-MM-dd");
    var today = ViewBag.Today as DateOnly? ?? Model.Range.End;
    var preset7Start = today.AddDays(-6).ToString("yyyy-MM-dd");
    var preset30Start = today.AddDays(-29).ToString("yyyy-MM-dd");
    var todayVal = today.ToString("yyyy-MM-dd");
    var jsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var trendLabels = (Model.OrdersTrendByDay ?? []).Select(x => x.Date.ToString("dd/MM")).ToList();
    var trendRevenue = (Model.OrdersTrendByDay ?? []).Select(x => x.Revenue).ToList();
    var trendOrders = (Model.OrdersTrendByDay ?? []).Select(x => x.OrderCount).ToList();
    // Horizontal bars: Chart.js draws bottom→top, so reverse for rank #1 on top.
    var topProductLabels = (Model.TopProducts ?? []).Select(x => x.Label).Reverse().ToList();
    var topProductValues = (Model.TopProducts ?? []).Select(x => x.Amount).Reverse().ToList();
    // Vertical category bars: natural order (largest first from service).
    var categoryLabels = (Model.RevenueByCategory ?? []).Select(x => x.Label).ToList();
    var categoryValues = (Model.RevenueByCategory ?? []).Select(x => x.Amount).ToList();
    var hasInventoryCard = Model.Inventory is not null;
    var orderLabels = (Model.OrdersByStatus ?? []).Select(x => x.Label).ToList();
    var orderValues = (Model.OrdersByStatus ?? []).Select(x => x.Count).ToList();
    var revenueSourceLabels = (Model.RevenueBySource ?? []).Select(x => x.Label).ToList();
    var revenueSourceValues = (Model.RevenueBySource ?? []).Select(x => x.Amount).ToList();
    var paymentLabels = (Model.RevenueByPaymentMethod ?? []).Select(x => x.Label).ToList();
    var paymentValues = (Model.RevenueByPaymentMethod ?? []).Select(x => x.Amount).ToList();
    var bookingLabels = (Model.BookingsByStatus ?? []).Select(x => x.Label).ToList();
    var bookingValues = (Model.BookingsByStatus ?? []).Select(x => x.Count).ToList();
    var bookingGmvLabels = (Model.BookingGmvByDay ?? []).Select(x => x.Date.ToString("dd/MM")).ToList();
    var bookingGmvValues = (Model.BookingGmvByDay ?? []).Select(x => x.Amount).ToList();
    var bookingCountTotal = (Model.BookingsByDay ?? []).Sum(x => x.Total);
    string Vnd(decimal v) => MoneyFormat.Vnd(v);
    string DeltaClass(decimal? pct) => pct is null ? "dash-delta dash-delta--flat" : pct >= 0 ? "dash-delta dash-delta--up" : "dash-delta dash-delta--down";
    string DeltaText(decimal? pct) => pct is null ? "Không so sánh được" : $"{(pct >= 0 ? "+" : "")}{pct:0.#}% so kỳ trước";
    string SparklineSvg(IReadOnlyList<decimal> series, string cssClass)
    {
        if (series.Count < 2) return "";
        const int w = 120, h = 28, pad = 2;
        var min = series.Min();
        var max = series.Max();
        var span = max - min;
        if (span == 0) span = 1;
        var pts = new System.Text.StringBuilder();
        for (var i = 0; i < series.Count; i++)
        {
            var x = pad + (w - 2 * pad) * i / (decimal)(series.Count - 1);
            var y = h - pad - (h - 2 * pad) * (series[i] - min) / span;
            if (i > 0) pts.Append(' ');
            pts.Append(FormattableString.Invariant($"{x:0.##},{y:0.##}"));
        }
        return $"<svg class=\"{cssClass}\" viewBox=\"0 0 {w} {h}\" width=\"{w}\" height=\"{h}\" aria-hidden=\"true\"><polyline fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" points=\"{pts}\"/></svg>";
    }
}

<div class="admin-toolbar">
    <h1>Dashboard</h1>
    <p class="muted" style="margin:0">@User.Identity?.Name</p>
</div>

<form method="get" class="dash-range filter-bar filter-bar--row">
    <label>Từ
        <input type="date" name="start" value="@startVal" class="form-control" required />
    </label>
    <label>Đến
        <input type="date" name="end" value="@endVal" class="form-control" required />
    </label>
    <button type="submit" class="btn-secondary">Áp dụng</button>
    <a class="btn-secondary" href="?start=@preset7Start&amp;end=@todayVal">7 ngày</a>
    <a class="btn-secondary" href="?start=@preset30Start&amp;end=@todayVal">30 ngày</a>
</form>

@{
    var commerceKpi = Model.Commerce;
}
@if (showRevenue && commerceKpi is not null)
{
    <div class="dash-kpi-grid dash-kpi-grid--commerce" data-commerce-kpis>
        <div class="dash-kpi">
            <span class="dash-kpi__label">Doanh thu</span>
            <span class="dash-kpi__value" data-kpi="revenue">@Vnd(commerceKpi!.Revenue)</span>
            <span class="@DeltaClass(commerceKpi.RevenueDeltaPct)">@DeltaText(commerceKpi.RevenueDeltaPct)</span>
            @if (trendRevenue.Count > 1)
            {
                @Html.Raw(SparklineSvg(trendRevenue, "dash-spark dash-spark--revenue"))
            }
        </div>
        <div class="dash-kpi">
            <span class="dash-kpi__label">Số đơn hàng</span>
            <span class="dash-kpi__value" data-kpi="orders">@commerceKpi.OrderCount.ToString("N0")</span>
            <span class="@DeltaClass(commerceKpi.OrderCountDeltaPct)">@DeltaText(commerceKpi.OrderCountDeltaPct)</span>
            <span class="dash-kpi__hint">Tất cả đơn tạo trong kỳ</span>
            @if (trendOrders.Count > 1)
            {
                @Html.Raw(SparklineSvg(trendOrders.Select(x => (decimal)x).ToList(), "dash-spark dash-spark--orders"))
            }
        </div>
        <a class="dash-kpi dash-kpi--link" asp-area="Admin" asp-controller="Orders" asp-action="Index" data-kpi-card="in-progress">
            <span class="dash-kpi__label">Đơn đang xử lý</span>
            <span class="dash-kpi__value" data-kpi="in-progress">@commerceKpi.InProgressOrderCount.ToString("N0")</span>
            <span class="dash-kpi__hint">Chờ xác nhận / đã xác nhận / đang xử lý (hiện tại)</span>
        </a>
        <div class="dash-kpi">
            <span class="dash-kpi__label">AOV</span>
            <span class="dash-kpi__value" data-kpi="aov">@Vnd(commerceKpi.Aov)</span>
            <span class="@DeltaClass(commerceKpi.AovDeltaPct)">@DeltaText(commerceKpi.AovDeltaPct)</span>
            <span class="dash-kpi__hint">Doanh thu / đơn đã xác nhận (@commerceKpi.RevenueOrderCount)</span>
        </div>
    </div>
}

@{
    var showOps = User.HasPermission(Permissions.Orders.View)
        || User.HasPermission(Permissions.Bookings.View)
        || User.HasPermission(Permissions.Inquiries.View)
        || User.HasPermission(Permissions.Applications.View)
        || Model.Inventory is not null;
}
@if (showOps)
{
    <div class="dash-ops-strip" data-ops-strip>
        <span class="dash-ops-strip__title">Cần xử lý</span>
        <div class="dash-ops-strip__chips">
            @if (User.HasPermission(Permissions.Orders.View))
            {
                <a class="dash-ops-chip" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                    Đơn chờ xử lý <strong>@k.PendingOrders</strong>
                </a>
            }
            @if (User.HasPermission(Permissions.Bookings.View))
            {
                <a class="dash-ops-chip" asp-area="Admin" asp-controller="ServiceBookings" asp-action="Index" asp-route-status="New">
                    Booking mới <strong>@k.NewBookings</strong>
                </a>
            }
            @if (User.HasPermission(Permissions.Inquiries.View))
            {
                <a class="dash-ops-chip" asp-area="Admin" asp-controller="Inquiries" asp-action="Index" asp-route-status="New">
                    Liên hệ mới <strong>@k.NewInquiries</strong>
                </a>
            }
            @if (User.HasPermission(Permissions.Applications.View))
            {
                <a class="dash-ops-chip" asp-area="Admin" asp-controller="Applications" asp-action="Index" asp-route-status="New">
                    Hồ sơ ứng tuyển mới <strong>@k.NewApplications</strong>
                </a>
            }
            @if (Model.Inventory is { } inv)
            {
                <a class="dash-ops-chip" asp-area="Admin" asp-controller="Inventory" asp-action="Index">
                    Giá trị kho <strong>@Vnd(inv.TotalValue)</strong>
                </a>
                <a class="dash-ops-chip" asp-area="Admin" asp-controller="Inventory" asp-action="Index" asp-route-expiringSoon="true">
                    Lô sắp hết hạn <strong>@inv.ExpiringSoonLotCount</strong>
                </a>
                <a class="dash-ops-chip" asp-area="Admin" asp-controller="Inventory" asp-action="Index">
                    SKU tồn thấp <strong>@inv.LowStockSkuCount</strong>
                </a>
            }
        </div>
    </div>
}

@if (showRevenue)
{
    <div class="dash-charts dash-charts--hero" data-dash-hero>
        <section class="dash-chart-card dash-chart-card--hero">
            <div class="dash-chart-card__head">
                <div>
                    <h2>Xu hướng doanh thu theo thời gian</h2>
                    <p class="muted">Doanh thu đã xác nhận · Số đơn tạo trong kỳ</p>
                </div>
                <div class="dash-chart-total">
                    <span class="dash-chart-total__label">Tổng GMV</span>
                    <span class="dash-chart-total__value">@Vnd(Model.OrderGmvTotal)</span>
                </div>
            </div>
            <canvas id="chart-orders-trend" height="140"></canvas>
        </section>

        <section class="dash-chart-card dash-chart-card--hero">
            <h2>Cơ cấu doanh thu theo danh mục</h2>
            <p class="muted">Theo danh mục sản phẩm (đơn đã xác nhận)</p>
            <canvas id="chart-revenue-category" height="140"></canvas>
            @if (Model.RevenueByCategory is null || Model.RevenueByCategory.Count == 0)
            {
                <p class="muted">Không có dữ liệu trong khoảng đã chọn.</p>
            }
        </section>
    </div>

    <div class="dash-charts dash-charts--insight" data-dash-insight>
        <section class="dash-chart-card">
            <h2>Top sản phẩm bán chạy</h2>
            <p class="muted">Theo doanh thu dòng (đơn đã xác nhận)</p>
            <canvas id="chart-top-products" height="160"></canvas>
            @if (Model.TopProducts is null || Model.TopProducts.Count == 0)
            {
                <p class="muted">Không có dữ liệu trong khoảng đã chọn.</p>
            }
        </section>

        <section class="dash-chart-card">
            <div class="dash-chart-card__head">
                <div>
                    <h2>Thu nhập theo kênh bán hàng</h2>
                    <p class="muted">Website / Cửa hàng / Shopee / TikTok</p>
                </div>
                <div class="dash-chart-total">
                    <span class="dash-chart-total__label">Tổng</span>
                    <span class="dash-chart-total__value">@Vnd(Model.OrderRevenueBySourceTotal)</span>
                </div>
            </div>
            <div class="dash-chart-donut">
                <canvas id="chart-revenue-source" height="160"></canvas>
            </div>
            @if (Model.RevenueBySource is null || Model.RevenueBySource.Count == 0)
            {
                <p class="muted">Không có doanh thu ghi nhận trong khoảng đã chọn.</p>
            }
        </section>

        @if (hasInventoryCard)
        {
            var inv = Model.Inventory!;
            var lowOk = inv.LowStockSkuCount == 0;
            var expOk = inv.ExpiringSoonLotCount == 0;
            var expiredOk = inv.ExpiredLotCount == 0;
            <section class="dash-chart-card" data-inventory-status>
                <h2>Tình trạng kho hàng</h2>
                <p class="muted">Giá trị kho @Vnd(inv.TotalValue)</p>
                <div class="dash-inv-grid">
                    <a class="dash-inv-cell @(lowOk ? "dash-inv-cell--ok" : "dash-inv-cell--warn")"
                       asp-area="Admin" asp-controller="Inventory" asp-action="Index">
                        <span class="dash-inv-cell__label">Tồn thấp</span>
                        <span class="dash-inv-cell__value">@inv.LowStockSkuCount</span>
                        <span class="dash-inv-cell__status">@(lowOk ? "An toàn" : "Cần nhập")</span>
                        <span class="dash-inv-cell__hint">Ngưỡng ≤ @inv.LowStockThreshold</span>
                    </a>
                    <a class="dash-inv-cell @(expOk ? "dash-inv-cell--ok" : "dash-inv-cell--warn")"
                       asp-area="Admin" asp-controller="Inventory" asp-action="Index" asp-route-expiringSoon="true">
                        <span class="dash-inv-cell__label">Sắp hết hạn</span>
                        <span class="dash-inv-cell__value">@inv.ExpiringSoonLotCount</span>
                        <span class="dash-inv-cell__status">@(expOk ? "An toàn" : "Cần xử lý")</span>
                        <span class="dash-inv-cell__hint">Trong @inv.ExpiringWithinDays ngày</span>
                    </a>
                    <a class="dash-inv-cell @(expiredOk ? "dash-inv-cell--ok" : "dash-inv-cell--danger")"
                       asp-area="Admin" asp-controller="Inventory" asp-action="Index">
                        <span class="dash-inv-cell__label">Lô quá hạn</span>
                        <span class="dash-inv-cell__value">@inv.ExpiredLotCount</span>
                        <span class="dash-inv-cell__status">@(expiredOk ? "An toàn" : "Khẩn")</span>
                        <span class="dash-inv-cell__hint">Không xuất được</span>
                    </a>
                </div>
            </section>
        }
        else
        {
            <section class="dash-chart-card">
                <h2>Đơn hàng theo trạng thái</h2>
                <p class="muted">Trong khoảng đã chọn</p>
                <div class="dash-chart-donut">
                    <canvas id="chart-orders-status" height="160"></canvas>
                </div>
                @if (Model.OrdersByStatus is null || Model.OrdersByStatus.Count == 0)
                {
                    <p class="muted">Không có đơn trong khoảng đã chọn.</p>
                }
            </section>
        }
    </div>

    <details class="dash-charts-more">
        <summary>Biểu đồ chi tiết thêm</summary>
        <div class="dash-charts dash-charts--more">
            <section class="dash-chart-card dash-chart-card--secondary">
                <h2>Phương thức thanh toán</h2>
                <p class="muted">Doanh thu đơn đã xác nhận</p>
                <canvas id="chart-payment-method" height="100"></canvas>
                @if (Model.RevenueByPaymentMethod is null || Model.RevenueByPaymentMethod.Count == 0)
                {
                    <p class="muted">Không có dữ liệu trong khoảng đã chọn.</p>
                }
            </section>

            @if (hasInventoryCard)
            {
                <section class="dash-chart-card dash-chart-card--secondary">
                    <h2>Đơn hàng theo trạng thái</h2>
                    <canvas id="chart-orders-status" height="100"></canvas>
                    @if (Model.OrdersByStatus is null || Model.OrdersByStatus.Count == 0)
                    {
                        <p class="muted">Không có đơn trong khoảng đã chọn.</p>
                    }
                </section>
            }

            <section class="dash-chart-card dash-chart-card--secondary">
                <div class="dash-chart-card__head">
                    <div>
                        <h2>GMV đặt lịch dịch vụ</h2>
                        <p class="muted">Ước tính theo giá variant · @bookingCountTotal booking</p>
                    </div>
                    <div class="dash-chart-total">
                        <span class="dash-chart-total__label">Tổng</span>
                        <span class="dash-chart-total__value">@Vnd(Model.BookingGmvTotal)</span>
                    </div>
                </div>
                <canvas id="chart-bookings-gmv" height="90"></canvas>
            </section>

            <section class="dash-chart-card dash-chart-card--secondary">
                <h2>Booking theo trạng thái</h2>
                <canvas id="chart-bookings-status" height="90"></canvas>
                @if (Model.BookingsByStatus is null || Model.BookingsByStatus.Count == 0)
                {
                    <p class="muted">Không có booking trong khoảng đã chọn.</p>
                }
            </section>
        </div>
    </details>
}

@section Scripts {
@if (showRevenue)
{
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(() => {
  const trendLabels = @Html.Raw(JsonSerializer.Serialize(trendLabels, jsonOpts));
  const trendRevenue = @Html.Raw(JsonSerializer.Serialize(trendRevenue, jsonOpts));
  const trendOrders = @Html.Raw(JsonSerializer.Serialize(trendOrders, jsonOpts));
  const topProductLabels = @Html.Raw(JsonSerializer.Serialize(topProductLabels, jsonOpts));
  const topProductValues = @Html.Raw(JsonSerializer.Serialize(topProductValues, jsonOpts));
  const categoryLabels = @Html.Raw(JsonSerializer.Serialize(categoryLabels, jsonOpts));
  const categoryValues = @Html.Raw(JsonSerializer.Serialize(categoryValues, jsonOpts));
  const orderLabels = @Html.Raw(JsonSerializer.Serialize(orderLabels, jsonOpts));
  const orderValues = @Html.Raw(JsonSerializer.Serialize(orderValues, jsonOpts));
  const revenueSourceLabels = @Html.Raw(JsonSerializer.Serialize(revenueSourceLabels, jsonOpts));
  const revenueSourceValues = @Html.Raw(JsonSerializer.Serialize(revenueSourceValues, jsonOpts));
  const paymentLabels = @Html.Raw(JsonSerializer.Serialize(paymentLabels, jsonOpts));
  const paymentValues = @Html.Raw(JsonSerializer.Serialize(paymentValues, jsonOpts));
  const bookingLabels = @Html.Raw(JsonSerializer.Serialize(bookingLabels, jsonOpts));
  const bookingValues = @Html.Raw(JsonSerializer.Serialize(bookingValues, jsonOpts));
  const bookingGmvLabels = @Html.Raw(JsonSerializer.Serialize(bookingGmvLabels, jsonOpts));
  const bookingGmvValues = @Html.Raw(JsonSerializer.Serialize(bookingGmvValues, jsonOpts));
  const palette = ['#2d6a4f','#1d3557','#457b9d','#e9c46a','#f4a261','#e76f51','#6c757d','#264653'];
  const money = v => new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND', maximumFractionDigits: 0 }).format(v);

  const trendEl = document.getElementById('chart-orders-trend');
  if (trendEl) {
    new Chart(trendEl, {
      data: {
        labels: trendLabels,
        datasets: [
          {
            type: 'line',
            label: 'Doanh thu',
            data: trendRevenue,
            borderColor: '#2d6a4f',
            backgroundColor: 'rgba(45,106,79,0.12)',
            fill: true,
            tension: 0.25,
            yAxisID: 'yMoney'
          },
          {
            type: 'bar',
            label: 'Số đơn',
            data: trendOrders,
            backgroundColor: 'rgba(29,53,87,0.45)',
            yAxisID: 'yCount',
            order: 2
          }
        ]
      },
      options: {
        responsive: true,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { position: 'bottom' },
          tooltip: {
            callbacks: {
              label: ctx => ctx.dataset.yAxisID === 'yMoney'
                ? `${ctx.dataset.label}: ${money(ctx.parsed.y ?? 0)}`
                : `${ctx.dataset.label}: ${ctx.parsed.y ?? 0}`
            }
          }
        },
        scales: {
          yMoney: {
            type: 'linear',
            position: 'left',
            beginAtZero: true,
            ticks: { callback: v => Number(v).toLocaleString('vi-VN') }
          },
          yCount: {
            type: 'linear',
            position: 'right',
            beginAtZero: true,
            grid: { drawOnChartArea: false },
            ticks: { precision: 0 }
          }
        }
      }
    });
  }

  function horizontalMoney(id, labels, values) {
    const el = document.getElementById(id);
    if (!el || !labels.length) return;
    // Top rank (last index after reverse) highlighted blue like the mock.
    const colors = values.map((_, i) => i === values.length - 1 ? '#2563eb' : '#2d6a4f');
    new Chart(el, {
      type: 'bar',
      data: {
        labels,
        datasets: [{
          data: values,
          backgroundColor: colors,
          borderRadius: 4
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: ctx => money(ctx.parsed.x ?? 0) } }
        },
        scales: {
          x: {
            beginAtZero: true,
            ticks: { callback: v => Number(v).toLocaleString('vi-VN') }
          }
        }
      }
    });
  }

  function verticalMoney(id, labels, values) {
    const el = document.getElementById(id);
    if (!el || !labels.length) return;
    new Chart(el, {
      type: 'bar',
      data: {
        labels,
        datasets: [{
          data: values,
          backgroundColor: labels.map((_, i) => palette[i % palette.length]),
          borderRadius: 6
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: ctx => money(ctx.parsed.y ?? 0) } }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { callback: v => Number(v).toLocaleString('vi-VN') }
          }
        }
      }
    });
  }

  horizontalMoney('chart-top-products', topProductLabels, topProductValues);
  verticalMoney('chart-revenue-category', categoryLabels, categoryValues);

  function lineMoneyChart(el, labels, values, color, fill) {
    if (!el) return;
    new Chart(el, {
      type: 'line',
      data: {
        labels,
        datasets: [{
          label: 'GMV',
          data: values,
          borderColor: color,
          backgroundColor: fill,
          fill: true,
          tension: 0.25
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: ctx => money(ctx.parsed.y ?? 0) } }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { callback: v => Number(v).toLocaleString('vi-VN') }
          }
        }
      }
    });
  }

  lineMoneyChart(document.getElementById('chart-bookings-gmv'), bookingGmvLabels, bookingGmvValues, '#1d3557', 'rgba(29,53,87,0.12)');

  function doughnut(id, labels, values, moneyMode) {
    const el = document.getElementById(id);
    if (!el || !labels.length) return;
    new Chart(el, {
      type: 'doughnut',
      data: {
        labels,
        datasets: [{
          data: values,
          backgroundColor: labels.map((_, i) => palette[i % palette.length])
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { position: 'bottom' },
          tooltip: moneyMode ? {
            callbacks: { label: ctx => `${ctx.label}: ${money(ctx.parsed ?? 0)}` }
          } : undefined
        }
      }
    });
  }

  doughnut('chart-revenue-source', revenueSourceLabels, revenueSourceValues, true);
  doughnut('chart-payment-method', paymentLabels, paymentValues, true);
  doughnut('chart-orders-status', orderLabels, orderValues, false);
  doughnut('chart-bookings-status', bookingLabels, bookingValues, false);
})();
</script>
}
}
