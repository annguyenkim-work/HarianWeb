@model IReadOnlyList<NewHarian.Application.Posts.SitePostListItemDto>
@using NewHarian.Domain.Enums
@using NewHarian.Web.Areas.Admin
@{
    var kind = (PostKind)ViewBag.Kind;
    Layout = "_AdminLayout";
    var pager = ViewBag.Pager as AdminPagerModel;
    var offset = pager?.Offset ?? 0;
    var total = pager?.TotalCount ?? Model.Count;
}

<div class="admin-toolbar">
    <h1>@ViewData["Title"]</h1>
    <button type="button" class="btn-icon btn-primary" id="btn-add-post" title="Thêm" aria-label="Thêm"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
</div>


<table class="data-table">
    <thead>
        <tr>
            <th class="sort-cell">Thứ tự</th>
            <th>Tiêu đề</th>
            <th>Slug</th>
            <th>Publish</th>
            <th>Ngày</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @for (var i = 0; i < Model.Count; i++)
    {
        var p = Model[i];
        var abs = offset + i;
        <tr>
            <td class="sort-cell">
                <div class="sort-controls">
                    <span class="sort-controls__pos">@(abs + 1)</span>
                    <form asp-action="Move" method="post" class="sort-controls__move">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@p.Id" />
                        <input type="hidden" name="kind" value="@kind" />
                        <button name="direction" value="-1" type="submit" class="btn-icon" title="Up" aria-label="Up" @(abs == 0 ? "disabled" : null)><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button>
                        <button name="direction" value="1" type="submit" class="btn-icon" title="Down" aria-label="Down" @(abs >= total - 1 ? "disabled" : null)><i class="fa-solid fa-arrow-down" aria-hidden="true"></i></button>
                    </form>
                </div>
            </td>
            <td>@p.Title</td>
            <td><code>@p.Slug</code></td>
            <td>@(p.IsPublished ? "Có" : "Nháp")</td>
            <td>@(p.PublishedAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "-")</td>
            <td class="actions">
                <button type="button" class="btn-icon btn-edit-post" data-id="@p.Id" title="Sửa" aria-label="Sửa"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>
                <form asp-action="Delete" method="post" class="inline" data-confirm="Xóa bài viết này?">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@p.Id" />
                    <input type="hidden" name="kind" value="@kind" />
                    <button type="submit" class="btn-icon btn-icon--danger" title="Delete" aria-label="Delete"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<partial name="_AdminPager" />

<div id="post-modal" class="admin-modal" hidden>
    <div class="admin-modal__backdrop" data-close-post-modal></div>
    <div class="admin-modal__panel modal__box modal__box--editor" id="post-modal-body"></div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/tinymce@7.6.0/tinymce.min.js" referrerpolicy="origin"></script>
<script>
(() => {
  const modal = document.getElementById('post-modal');
  const body = document.getElementById('post-modal-body');
  const kind = '@kind';

  function openModal() {
    modal.hidden = false;
    document.body.classList.add('admin-modal-open');
  }
  function destroyEditors() {
    if (!window.tinymce) return;
    body.querySelectorAll('textarea.richtext').forEach(ta => tinymce.get(ta.id)?.remove());
  }
  function closeModal() {
    destroyEditors();
    modal.hidden = true;
    document.body.classList.remove('admin-modal-open');
    body.innerHTML = '';
  }
  function initEditors(scope) {
    const root = scope || body;
    if (!root || !window.AdminRichText) return;
    const token = body.querySelector('input[name="__RequestVerificationToken"]')?.value;
    AdminRichText.init(root.querySelectorAll('textarea.richtext'), {
      menubar: false,
      plugins: 'lists link table code autoresize image media',
      toolbar: 'undo redo | styles | bold italic underline | alignleft aligncenter alignright | bullist numlist | link image media table | removeformat | code',
      automatic_uploads: true,
      images_upload_handler: (blobInfo) => new Promise((resolve, reject) => {
        const fd = new FormData();
        fd.append('file', blobInfo.blob(), blobInfo.filename());
        if (token) fd.append('__RequestVerificationToken', token);
        fetch('@Url.Action("UploadImage", "Posts")', { method: 'POST', body: fd })
          .then(res => res.json().then(data => ({ ok: res.ok, data })))
          .then(({ ok, data }) => {
            if (!ok || !data?.ok || !data.url) reject(data?.error || 'Upload lỗi');
            else resolve(data.url);
          })
          .catch(() => reject('Upload lỗi'));
      }),
      valid_elements: '*[*]',
      extended_valid_elements: 'iframe[src|width|height|frameborder|allow|allowfullscreen|style|class|id|title|loading|referrerpolicy],video[*],audio[*],source[*],style[*]',
      valid_children: '+body[style],+div[style]',
      verify_html: false,
      sandbox_iframes: false,
      media_live_embeds: true,
      content_style: 'body { font-family: Segoe UI, sans-serif; font-size: 14px; } img, video, iframe { max-width: 100%; height: auto; }'
    });
  }
  function bindForm() {
    const form = body.querySelector('form');
    if (!form) return;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (window.tinymce) tinymce.triggerSave();
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const ct = res.headers.get('content-type') || '';
      if (ct.includes('application/json')) {
        const data = await res.json();
        if (data.ok) { adminToast.reloadWith(data.message, data.redirect); return; }
        adminToast.jsonError(data);
        return;
      }
      destroyEditors();
      body.innerHTML = await res.text();
      bindForm();
      initEditors();
      adminToast.formErrors(body);
    });
  }
  async function openForm(id) {
    const url = id ? `/admin/Posts/Edit/${id}?kind=${encodeURIComponent(kind)}` : `/admin/Posts/Edit?kind=${encodeURIComponent(kind)}`;
    const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
    if (!res.ok) { adminToast.error('Không mở được form.'); return; }
    destroyEditors();
    body.innerHTML = await res.text();
    openModal();
    bindForm();
    initEditors();
  }

  document.getElementById('btn-add-post')?.addEventListener('click', () => openForm(null));
  document.querySelectorAll('.btn-edit-post').forEach(btn => btn.addEventListener('click', () => openForm(btn.dataset.id)));
  modal?.addEventListener('click', (e) => {
    if (e.target.closest('[data-close-post-modal]')) closeModal();
  });
  document.addEventListener('admin-lang-shown', (e) => {
    if (e.target instanceof Element && e.target.closest('#post-form')) initEditors(e.target);
  });
})();
</script>
}
