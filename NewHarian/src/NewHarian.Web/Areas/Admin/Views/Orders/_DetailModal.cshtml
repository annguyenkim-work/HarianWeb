@model NewHarian.Application.Orders.OrderSummaryDto
@using NewHarian.Application.Orders

<h2>@Model.OrderNumber</h2>

<div class="detail-grid">
    <div class="detail-field">
        <span class="detail-field__label">Khách</span>
        <span class="detail-field__value">@Model.CustomerName</span>
    </div>
    <div class="detail-field">
        <span class="detail-field__label">Email</span>
        <span class="detail-field__value">@(string.IsNullOrWhiteSpace(Model.CustomerEmail) ? "-" : Model.CustomerEmail)</span>
    </div>
    <div class="detail-field">
        <span class="detail-field__label">SĐT</span>
        <span class="detail-field__value">@(Model.CustomerPhone ?? "-")</span>
    </div>
    <div class="detail-field">
        <span class="detail-field__label">CCCD</span>
        <span class="detail-field__value">@(string.IsNullOrWhiteSpace(Model.CitizenId) ? "-" : Model.CitizenId)</span>
    </div>
    @if (Model.DealerId is not null)
    {
        <div class="detail-field">
            <span class="detail-field__label">Đại lý</span>
            <span class="detail-field__value">@(Model.DealerName ?? $"#{Model.DealerId}")</span>
        </div>
        <div class="detail-field">
            <span class="detail-field__label">Chiết khấu</span>
            <span class="detail-field__value">@(Model.DealerDiscountPercent?.ToString("0.##") ?? "0")% (−@Model.DiscountAmount.ToString("N0")đ)</span>
        </div>
    }
    <div class="detail-field">
        <span class="detail-field__label">Nguồn</span>
        <span class="detail-field__value">@OrderSourceLabels.Vi(Model.Source)</span>
    </div>
    <div class="detail-field">
        <span class="detail-field__label">Mã ngoài</span>
        <span class="detail-field__value">@(string.IsNullOrWhiteSpace(Model.ExternalRef) ? "-" : Model.ExternalRef)</span>
    </div>
    <div class="detail-field">
        <span class="detail-field__label">PT TT</span>
        <span class="detail-field__value">@Model.PaymentMethod</span>
    </div>
    <div class="detail-field">
        <span class="detail-field__label">Status</span>
        <span class="detail-field__value">@Model.Status</span>
    </div>
    <div class="detail-field">
        <span class="detail-field__label">Ngày đặt</span>
        <span class="detail-field__value">@Model.CreatedAt.ToLocalTime().ToString("g")</span>
    </div>
    <div class="detail-field detail-field--wide">
        <span class="detail-field__label">Địa chỉ</span>
        <span class="detail-field__value">@AddressFormat.Join(Model.ShippingAddress, Model.ShippingDistrict, Model.ProvinceName)</span>
    </div>
    <div class="detail-field detail-field--wide">
        <span class="detail-field__label">Ghi chú KH</span>
        <span class="detail-field__value">@(Model.Notes ?? "-")</span>
    </div>
    <div class="detail-field detail-field--wide">
        <span class="detail-field__label">Tổng</span>
        <span class="detail-field__value"><strong>@Model.Total.ToString("N0")đ</strong>
            <span class="muted">(SP @Model.SubTotal.ToString("N0")đ
            @if (Model.DiscountAmount > 0)
            {
                <text> − CK @Model.DiscountAmount.ToString("N0")đ</text>
            }
            + ship @Model.ShippingFee.ToString("N0")đ)</span>
        </span>
    </div>
</div>

<ul class="order-detail-items">
@foreach (var i in Model.Items)
{
    <li>@(string.IsNullOrWhiteSpace(i.VariantLabel) ? i.ProductName : $"{i.ProductName} - {i.VariantLabel}") (@i.Sku) × @i.Quantity = @i.LineTotal.ToString("N0")đ</li>
}
</ul>

@{
    var stockPick = ViewBag.StockPick as NewHarian.Application.Inventory.OrderStockPickPlanDto;
}
@if (stockPick is not null && stockPick.Lines.Count > 0)
{
    <div class="order-stock-pick" style="margin:1rem 0;padding:0.75rem;border:1px solid var(--border, #ddd);border-radius:6px">
        <strong>@(stockPick.AlreadyDeducted ? "Đã lấy hàng (FEFO)" : "Gợi ý lấy hàng (FEFO)")</strong>
        @foreach (var line in stockPick.Lines)
        {
            <div style="margin-top:0.5rem">
                <div>@line.Sku - @line.ProductName × @line.RequestedQty
                    @if (line.ShortfallQty > 0)
                    {
                        <span class="text-danger">(thiếu @line.ShortfallQty@(line.ExpiredQty > 0 ? $", {line.ExpiredQty} trong lô hết hạn không xuất" : ""))</span>
                    }
                </div>
                @if (line.Suggestions.Count == 0)
                {
                    <p class="muted" style="margin:0.25rem 0 0">Chưa có lô tồn.</p>
                }
                else
                {
                    <ul style="margin:0.25rem 0 0;padding-left:1.25rem">
                    @foreach (var s in line.Suggestions)
                    {
                        <li>@s.LocationCode (@s.LocationName) · lô @(s.LotCode ?? "-") · HSD @s.ExpiryDate.ToString("dd/MM/yyyy") · lấy @s.AllocateQty</li>
                    }
                    </ul>
                }
            </div>
        }
    </div>
}

<label>Ghi chú nội bộ
    <textarea name="internalNotes" class="form-control" rows="2">@Model.InternalNotes</textarea>
</label>

@{
    var canUpdateStatus = User.HasPermission(Permissions.Orders.UpdateStatus);
}
<div class="order-actions" style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-top:1rem">
@if (OrderStatusPolicy.CanConfirmCod(Model.Status, Model.PaymentMethod)
     && User.HasPermission(Permissions.Orders.ConfirmCod))
{
    <button type="button" class="btn-primary" data-action="confirm-cod" data-id="@Model.Id">Xác nhận COD</button>
}
@if (OrderStatusPolicy.CanConfirmBankTransfer(Model.Status, Model.PaymentMethod)
     && User.HasPermission(Permissions.Orders.ConfirmBankTransfer))
{
    <button type="button" class="btn-primary" data-action="confirm-payment" data-id="@Model.Id">Xác nhận CK</button>
}
@if (OrderStatusPolicy.CanTransition(Model.Status, NewHarian.Domain.Enums.OrderStatus.Processing) && canUpdateStatus)
{
    <button type="button" class="btn-secondary" data-action="status" data-status="Processing" data-id="@Model.Id">Bắt đầu xử lý</button>
}
@if (OrderStatusPolicy.CanTransition(Model.Status, NewHarian.Domain.Enums.OrderStatus.Shipped) && canUpdateStatus)
{
    <button type="button" class="btn-secondary" data-action="status" data-status="Shipped" data-id="@Model.Id">Đã giao vận</button>
}
@if (OrderStatusPolicy.CanTransition(Model.Status, NewHarian.Domain.Enums.OrderStatus.Delivered) && canUpdateStatus)
{
    <button type="button" class="btn-secondary" data-action="status" data-status="Delivered" data-id="@Model.Id">Hoàn thành</button>
}
@if (OrderStatusPolicy.CanTransition(Model.Status, NewHarian.Domain.Enums.OrderStatus.Cancelled)
    && canUpdateStatus && User.HasPermission(Permissions.Orders.Cancel))
{
    <button type="button" class="btn-link" data-action="status" data-status="Cancelled" data-id="@Model.Id">Hủy đơn</button>
}
</div>

@{
    var histories = ViewBag.Histories as IReadOnlyList<NewHarian.Application.Admin.StatusHistoryItemDto>
                    ?? Array.Empty<NewHarian.Application.Admin.StatusHistoryItemDto>();
}
<partial name="_StatusHistory" model="histories" />

<div class="modal__actions">
    @if (User.HasPermission(Permissions.Orders.Print))
    {
        <a class="btn-secondary" href="@Url.Action("Print", new { id = Model.Id })" target="_blank" rel="noopener">In phiếu</a>
    }
    <button type="button" class="btn-secondary" data-close>Đóng</button>
</div>
