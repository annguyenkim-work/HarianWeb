@model IReadOnlyList<NewHarian.Application.Orders.AdminOrderListItemDto>
@using NewHarian.Application.Orders
@using NewHarian.Domain.Enums
@{
    ViewData["Title"] = "Đơn hàng";
    Layout = "_AdminLayout";
    var sort = (string)(ViewBag.Sort ?? "createdAt");
    var dir = (string)(ViewBag.Dir ?? "desc");
    DateOnly? from = ViewBag.From as DateOnly?;
    DateOnly? to = ViewBag.To as DateOnly?;
    var selectedSource = ViewBag.Source as OrderSource?;
}

<div class="admin-toolbar">
    <h1>Đơn hàng</h1>
    <div class="admin-toolbar__actions">
        <a class="btn-secondary"
           asp-action="Export"
           asp-route-status="@ViewBag.Status"
           asp-route-payment="@ViewBag.Payment"
           asp-route-source="@ViewBag.Source"
           asp-route-q="@ViewBag.Q"
           asp-route-sort="@sort"
           asp-route-dir="@dir"
           asp-route-from="@(from?.ToString("yyyy-MM-dd"))"
           asp-route-to="@(to?.ToString("yyyy-MM-dd"))">Export</a>
        <button type="button" class="btn-secondary" id="btn-import-orders" title="Import Excel">Import</button>
        <button type="button" class="btn-icon btn-primary" id="btn-add-order" title="Thêm đơn" aria-label="Thêm đơn"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
    </div>
</div>

<form method="get" class="filter-bar filter-bar--row">
    <input type="hidden" name="sort" value="@sort" />
    <input type="hidden" name="dir" value="@dir" />
    <select name="status" aria-label="Trạng thái">
        <option value="">Trạng thái</option>
        @foreach (OrderStatus s in Enum.GetValues(typeof(OrderStatus)))
        {
            if (ViewBag.Status as OrderStatus? == s)
            {
                <option value="@s" selected>@s</option>
            }
            else
            {
                <option value="@s">@s</option>
            }
        }
    </select>
    <select name="payment" aria-label="Thanh toán">
        <option value="">Thanh toán</option>
        @foreach (PaymentMethod p in Enum.GetValues(typeof(PaymentMethod)))
        {
            if (p == PaymentMethod.OnlineGateway) { continue; }
            if (ViewBag.Payment as PaymentMethod? == p)
            {
                <option value="@p" selected>@p</option>
            }
            else
            {
                <option value="@p">@p</option>
            }
        }
    </select>
    <select name="source" aria-label="Nguồn">
        <option value="">Nguồn</option>
        @foreach (OrderSource src in Enum.GetValues(typeof(OrderSource)))
        {
            if (selectedSource == src)
            {
                <option value="@src" selected>@OrderSourceLabels.Vi(src)</option>
            }
            else
            {
                <option value="@src">@OrderSourceLabels.Vi(src)</option>
            }
        }
    </select>
    <div class="filter-bar__field">
        <label for="from">Từ ngày đặt</label>
        <input id="from" type="date" name="from" value="@(from?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="filter-bar__field">
        <label for="to">Đến</label>
        <input id="to" type="date" name="to" value="@(to?.ToString("yyyy-MM-dd"))" />
    </div>
    <input type="search" name="q" value="@ViewBag.Q" placeholder="Mã đơn / tên / email / SĐT" class="form-control filter-bar__search" />
    <button type="submit" class="btn-secondary filter-bar__submit">Tìm kiếm</button>
</form>

@Html.AntiForgeryToken()

<table class="data-table">
    <thead>
        <tr>
            <partial name="_SortableTh" model='new SortableThModel { Column = "orderNumber", Label = "Mã đơn", CurrentSort = sort, CurrentDir = dir }' />
            <partial name="_SortableTh" model='new SortableThModel { Column = "customer", Label = "Khách", CurrentSort = sort, CurrentDir = dir }' />
            <partial name="_SortableTh" model='new SortableThModel { Column = "total", Label = "Tổng", CurrentSort = sort, CurrentDir = dir }' />
            <partial name="_SortableTh" model='new SortableThModel { Column = "source", Label = "Nguồn", CurrentSort = sort, CurrentDir = dir }' />
            <partial name="_SortableTh" model='new SortableThModel { Column = "payment", Label = "PT TT", CurrentSort = sort, CurrentDir = dir }' />
            <partial name="_SortableTh" model='new SortableThModel { Column = "status", Label = "Status", CurrentSort = sort, CurrentDir = dir }' />
            <partial name="_SortableTh" model='new SortableThModel { Column = "createdAt", Label = "Ngày", CurrentSort = sort, CurrentDir = dir }' />
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var o in Model)
    {
        <tr data-id="@o.Id">
            <td>@o.OrderNumber</td>
            <td>@o.CustomerName<br /><span class="muted">@o.CustomerEmail</span></td>
            <td>@o.Total.ToString("N0")đ</td>
            <td>@OrderSourceLabels.Vi(o.Source)</td>
            <td>@o.PaymentMethod</td>
            <td class="col-status">@o.Status</td>
            <td>@o.CreatedAt.ToLocalTime().ToString("g")</td>
            <td><button type="button" class="btn-icon btn-order-detail" data-id="@o.Id" title="Detail" aria-label="Detail"><i class="fa-solid fa-eye" aria-hidden="true"></i></button></td>
        </tr>
    }
    </tbody>
</table>

<partial name="_AdminPager" />

<div id="order-modal" class="admin-modal" hidden>
    <div class="admin-modal__backdrop" data-close-modal></div>
    <div class="admin-modal__panel modal__box modal__box--order-detail" id="order-modal-body"></div>
</div>

<dialog id="order-create-modal" class="modal">
    <div class="modal__box modal__box--wide" id="order-create-modal-body"></div>
</dialog>

<dialog id="order-import-modal" class="modal">
    <div class="modal__box modal__box--wide" id="order-import-modal-body"></div>
</dialog>

@section Scripts {
<script>
(() => {
  const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
  const modal = document.getElementById('order-modal');
  const body = document.getElementById('order-modal-body');
  const createModal = document.getElementById('order-create-modal');
  const createBody = document.getElementById('order-create-modal-body');
  const importModal = document.getElementById('order-import-modal');
  const importBody = document.getElementById('order-import-modal-body');

  const open = async (id) => {
    const res = await fetch('@Url.Action("Detail")?id=' + id);
    body.innerHTML = await res.text();
    modal.hidden = false;
  };
  document.querySelectorAll('.btn-order-detail').forEach(btn => btn.addEventListener('click', () => open(btn.dataset.id)));
  modal?.addEventListener('click', e => {
    if (e.target.matches('[data-close], [data-close-modal]')) modal.hidden = true;
  });
  body?.addEventListener('click', async e => {
    const btn = e.target.closest('[data-action]');
    if (!btn) return;
    const id = btn.dataset.id;
    const notes = body.querySelector('[name="internalNotes"]')?.value ?? '';
    let url = '';
    const fd = new FormData();
    fd.append('__RequestVerificationToken', token);
    fd.append('id', id);
    fd.append('internalNotes', notes);
    if (btn.dataset.action === 'confirm-cod') url = '@Url.Action("ConfirmCod")';
    else if (btn.dataset.action === 'confirm-payment') url = '@Url.Action("ConfirmPayment")';
    else if (btn.dataset.action === 'status') {
      url = '@Url.Action("UpdateStatus")';
      fd.append('status', btn.dataset.status);
    } else return;
    const res = await fetch(url, { method: 'POST', body: fd });
    const json = await res.json();
    if (json.ok) location.reload();
    else alert(json.error || 'Lỗi');
  });

  function reindexLines(root) {
    root.querySelectorAll('.manual-order-line').forEach((row, i) => {
      row.querySelectorAll('[name]').forEach(inp => {
        inp.name = inp.name.replace(/Lines\[\d+]/, `Lines[${i}]`);
      });
    });
  }

  function wireSkuSuggest(form) {
    const url = form.dataset.suggestUrl;
    if (!url || form.dataset.skuWired === '1') return;
    form.dataset.skuWired = '1';
    let timer = null;

    const hideLists = (except) => {
      form.querySelectorAll('.sku-suggest__list').forEach(list => {
        if (list !== except) {
          list.hidden = true;
          list.innerHTML = '';
        }
      });
    };

    form.addEventListener('input', (e) => {
      const input = e.target.closest('.js-sku-input');
      if (!input) return;
      const wrap = input.closest('.sku-suggest');
      const list = wrap?.querySelector('.sku-suggest__list');
      if (!list) return;
      clearTimeout(timer);
      const q = input.value.trim();
      if (q.length < 1) {
        hideLists();
        return;
      }
      timer = setTimeout(async () => {
        try {
          const res = await fetch(url + '?q=' + encodeURIComponent(q));
          const items = await res.json();
          if (!Array.isArray(items) || items.length === 0) {
            list.innerHTML = '<li class="sku-suggest__empty">Không tìm thấy</li>';
            list.hidden = false;
            hideLists(list);
            return;
          }
          list.innerHTML = items.map(it => {
            const sku = it.sku ?? it.Sku ?? '';
            const price = it.price ?? it.Price ?? '';
            const display = it.display ?? it.Display ?? sku;
            return `<li role="option" tabindex="-1" data-sku="${escapeAttr(sku)}" data-price="${escapeAttr(price)}">${escapeHtml(display)}</li>`;
          }).join('');
          list.hidden = false;
          hideLists(list);
        } catch {
          hideLists();
        }
      }, 220);
    });

    form.addEventListener('click', (e) => {
      const opt = e.target.closest('.sku-suggest__list [data-sku]');
      if (!opt) return;
      e.preventDefault();
      const wrap = opt.closest('.sku-suggest');
      const row = opt.closest('.manual-order-line');
      const input = wrap?.querySelector('.js-sku-input');
      const price = row?.querySelector('.js-sku-price');
      const list = wrap?.querySelector('.sku-suggest__list');
      if (input) input.value = opt.dataset.sku || '';
      if (price && opt.dataset.price !== undefined && opt.dataset.price !== '') {
        price.value = String(Math.round(Number(opt.dataset.price)));
      }
      if (list) {
        list.hidden = true;
        list.innerHTML = '';
      }
    });

    form.addEventListener('focusin', (e) => {
      if (!e.target.closest('.sku-suggest')) hideLists();
    });

    document.addEventListener('click', (e) => {
      if (!form.contains(e.target)) hideLists();
      else if (!e.target.closest('.sku-suggest')) hideLists();
    });
  }

  function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, c => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[c]));
  }
  function escapeAttr(s) {
    return escapeHtml(s).replace(/`/g, '');
  }

  function bindCreateForm() {
    const form = createBody.querySelector('form');
    if (!form) return;
    wireSkuSuggest(form);

    createBody.querySelector('#btn-add-line')?.addEventListener('click', () => {
      const tpl = createBody.querySelector('#manual-order-line-tpl');
      const wrap = createBody.querySelector('#manual-order-lines');
      if (!tpl || !wrap) return;
      wrap.insertAdjacentHTML('beforeend', tpl.innerHTML.replaceAll('__i__', '0'));
      reindexLines(wrap);
    });

    createBody.querySelector('#manual-order-lines')?.addEventListener('click', e => {
      const btn = e.target.closest('[data-remove-line]');
      if (!btn) return;
      const wrap = createBody.querySelector('#manual-order-lines');
      const rows = wrap.querySelectorAll('.manual-order-line');
      if (rows.length <= 1) return;
      btn.closest('.manual-order-line')?.remove();
      reindexLines(wrap);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const ct = res.headers.get('content-type') || '';
      if (ct.includes('application/json')) {
        const data = await res.json();
        if (data.ok) {
          location.href = data.redirect || location.pathname;
          return;
        }
      } else {
        createBody.innerHTML = await res.text();
        bindCreateForm();
      }
    });

    createBody.querySelector('[data-close]')?.addEventListener('click', () => createModal.close());
  }

  async function openCreate() {
    createBody.innerHTML = await (await fetch('@Url.Action("Create")')).text();
    createModal.showModal();
    bindCreateForm();
  }

  function bindImportForm() {
    const form = importBody.querySelector('form');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        importBody.innerHTML = await res.text();
        bindImportForm();
      });
    }
    importBody.querySelectorAll('[data-close]').forEach(btn => {
      btn.addEventListener('click', () => {
        importModal.close();
        if (btn.hasAttribute('data-reload')) location.reload();
      });
    });
  }

  async function openImport() {
    importBody.innerHTML = await (await fetch('@Url.Action("Import")')).text();
    importModal.showModal();
    bindImportForm();
  }

  document.getElementById('btn-add-order')?.addEventListener('click', () => openCreate());
  document.getElementById('btn-import-orders')?.addEventListener('click', () => openImport());
})();
</script>
}
