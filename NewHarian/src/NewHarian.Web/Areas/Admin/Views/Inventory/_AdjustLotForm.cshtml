@model NewHarian.Application.Inventory.StockLotAdjustRequest
@using NewHarian.Application.Inventory
@{
    var lot = ViewBag.Lot as StockLotListItemDto;
}

<form asp-action="Adjust" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="LotId" />
    <h2>Điều chỉnh tồn lô</h2>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @if (lot is not null)
    {
        <p class="muted">@lot.Sku - @lot.ProductName @(!string.IsNullOrWhiteSpace(lot.VariantLabel) ? $"({lot.VariantLabel})" : "") · @lot.LocationCode · HSD @lot.ExpiryDate.ToString("dd/MM/yyyy")</p>
    }
    <label>Số lượng còn lại <input asp-for="QuantityOnHand" type="number" class="form-control" required /></label>
    <label>Ghi chú <input asp-for="Notes" class="form-control" maxlength="1000" /></label>
    <div style="margin-top:1rem;display:flex;gap:0.5rem">
        <button type="submit" class="btn-primary">Lưu</button>
        <button type="button" class="btn-link" data-close-inventory-modal>Đóng</button>
    </div>
</form>
