@model NewHarian.Application.Dealers.DealerCreateRequest
@{
    Layout = null;
}
<form id="dealer-create-form" asp-area="Admin" asp-controller="Dealers" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <h2>Thêm đại lý</h2>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="detail-grid">
        <label class="detail-field">
            <span class="detail-field__label">Họ tên *</span>
            <input asp-for="FullName" class="form-control" required maxlength="200" />
        </label>
        <label class="detail-field">
            <span class="detail-field__label">SĐT *</span>
            <input asp-for="Phone" class="form-control" required maxlength="20" />
        </label>
        <label class="detail-field">
            <span class="detail-field__label">Email *</span>
            <input asp-for="Email" type="email" class="form-control" required maxlength="200" />
        </label>
        <label class="detail-field">
            <span class="detail-field__label">CCCD *</span>
            <input asp-for="CitizenId" class="form-control" required maxlength="20" inputmode="numeric" />
        </label>
        <label class="detail-field">
            <span class="detail-field__label">Chiết khấu % *</span>
            <input asp-for="DiscountPercent" type="number" min="0" max="100" step="0.01" class="form-control" required />
        </label>
        <div class="detail-field detail-field--wide">
            @await Html.PartialAsync("~/Views/Shared/_AddressFields.cshtml", new AddressFieldsModel { ProvinceField = "ProvinceCode", CommuneField = "CommuneCode", LineField = "Address", ProvinceValue = Model.ProvinceCode, CommuneValue = Model.CommuneCode, LineValue = Model.Address })
        </div>
        <label class="detail-field">
            <span class="detail-field__label">Ghi chú</span>
            <textarea asp-for="Message" class="form-control" rows="2"></textarea>
        </label>
        <label class="detail-field">
            <span class="detail-field__label">Ghi chú nội bộ</span>
            <textarea asp-for="InternalNotes" class="form-control" rows="2"></textarea>
        </label>
    </div>
    <div class="modal__actions">
        <button type="button" class="btn-secondary" data-close>Hủy</button>
        <button type="submit" class="btn-primary">Tạo</button>
    </div>
</form>
