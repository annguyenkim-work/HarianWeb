@model IReadOnlyList<NewHarian.Application.Dealers.DealerListItemDto>
@using NewHarian.Domain.Enums
@{
    ViewData["Title"] = "Đại lý";
    Layout = "_AdminLayout";
    var statuses = Enum.GetValues<DealerStatus>();
    var sort = (string)(ViewBag.Sort ?? "createdAt");
    var dir = (string)(ViewBag.Dir ?? "desc");
}

<div class="admin-toolbar">
    <h1>Đại lý</h1>
    <div class="admin-toolbar__actions">
        <button type="button" class="btn-icon btn-primary" id="btn-add-dealer" title="Thêm đại lý" aria-label="Thêm đại lý"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
    </div>
</div>

@if (TempData["Success"] is string ok) { <p class="text-success">@ok</p> }
@if (TempData["Error"] is string err) { <p class="text-danger">@err</p> }

<form method="get" class="filter-bar filter-bar--row">
    <input type="hidden" name="sort" value="@sort" />
    <input type="hidden" name="dir" value="@dir" />
    <select name="status" aria-label="Trạng thái">
        <option value="">Trạng thái</option>
        @foreach (var s in statuses)
        {
            if (ViewBag.Status as DealerStatus? == s)
            {
                <option value="@s" selected>@s</option>
            }
            else
            {
                <option value="@s">@s</option>
            }
        }
    </select>
    <input type="search" name="q" value="@ViewBag.Q" placeholder="Tìm tên / email / SĐT / CCCD" class="form-control filter-bar__search" />
    <button type="submit" class="btn-secondary filter-bar__submit">Tìm kiếm</button>
</form>

@Html.AntiForgeryToken()

<table class="data-table">
    <thead>
        <tr>
            <partial name="_SortableTh" model='new SortableThModel { Column = "id", Label = "#", CurrentSort = sort, CurrentDir = dir }' />
            <partial name="_SortableTh" model='new SortableThModel { Column = "createdAt", Label = "Ngày", CurrentSort = sort, CurrentDir = dir }' />
            <partial name="_SortableTh" model='new SortableThModel { Column = "name", Label = "Họ tên", CurrentSort = sort, CurrentDir = dir }' />
            <partial name="_SortableTh" model='new SortableThModel { Column = "phone", Label = "SĐT", CurrentSort = sort, CurrentDir = dir }' />
            <partial name="_SortableTh" model='new SortableThModel { Column = "email", Label = "Email", CurrentSort = sort, CurrentDir = dir }' />
            <partial name="_SortableTh" model='new SortableThModel { Column = "status", Label = "Status", CurrentSort = sort, CurrentDir = dir }' />
            <th>%</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var d in Model)
    {
        <tr>
            <td>@d.Id</td>
            <td>@d.CreatedAt.ToLocalTime().ToString("g")</td>
            <td>@d.FullName</td>
            <td>@d.Phone</td>
            <td>@d.Email</td>
            <td>@d.Status</td>
            <td>@(d.DiscountPercent?.ToString("0.##") ?? "—")</td>
            <td>
                <button type="button" class="btn-icon btn-detail" data-id="@d.Id" title="Chi tiết" aria-label="Chi tiết"><i class="fa-solid fa-eye" aria-hidden="true"></i></button>
            </td>
        </tr>
    }
    </tbody>
</table>

<partial name="_AdminPager" />

<div id="dealer-modal" class="admin-modal" hidden>
    <div class="admin-modal__backdrop" data-close-modal></div>
    <div class="admin-modal__panel modal__box modal__box--wide" id="dealer-modal-body"></div>
</div>

@section Scripts {
<script>
(() => {
  const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
  const modal = document.getElementById('dealer-modal');
  const body = document.getElementById('dealer-modal-body');
  const open = async (url) => {
    body.innerHTML = await (await fetch(url)).text();
    window.HarianAddress?.bindAll();
    modal.hidden = false;
  };
  document.getElementById('btn-add-dealer')?.addEventListener('click', () => open('@Url.Action("Create")'));
  document.querySelectorAll('.btn-detail').forEach(btn => btn.addEventListener('click', () => open('@Url.Action("Detail")?id=' + btn.dataset.id)));
  modal?.addEventListener('click', e => {
    if (e.target.matches('[data-close], [data-close-modal]')) modal.hidden = true;
  });
  body?.addEventListener('click', async e => {
    const btn = e.target.closest('[data-action]');
    if (!btn) return;
    const id = btn.dataset.id;
    const notes = body.querySelector('[name="internalNotes"]')?.value ?? '';
    const pct = body.querySelector('[name="discountPercent"]')?.value ?? '';
    const citizenId = body.querySelector('[name="citizenId"]')?.value ?? '';
    const fd = new FormData();
    fd.append('__RequestVerificationToken', token);
    fd.append('id', id);
    fd.append('internalNotes', notes);
    fd.append('citizenId', citizenId);
    let url = '';
    if (btn.dataset.action === 'approve') {
      url = '@Url.Action("Approve")';
      fd.append('discountPercent', pct);
    } else if (btn.dataset.action === 'reject') {
      url = '@Url.Action("Reject")';
    } else if (btn.dataset.action === 'save') {
      url = '@Url.Action("Save")';
      fd.append('discountPercent', pct);
    } else return;
    const res = await fetch(url, { method: 'POST', body: fd });
    const json = await res.json();
    if (json.ok) location.reload();
    else alert(json.error || 'Lỗi');
  });
  body?.addEventListener('submit', async e => {
    const form = e.target.closest('#dealer-create-form');
    if (!form) return;
    e.preventDefault();
    const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { 'Accept': 'application/json' } });
    const json = await res.json();
    if (json.ok) location.reload();
    else alert(json.error || 'Lỗi');
  });
})();
</script>
}
