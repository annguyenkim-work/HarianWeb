@model NewHarian.Application.Dealers.DealerDetailDto
@using NewHarian.Domain.Enums

<h2>Đại lý #@Model.Id</h2>

<div class="detail-grid">
    <div class="detail-field">
        <span class="detail-field__label">Họ tên</span>
        <span class="detail-field__value">@Model.FullName</span>
    </div>
    <div class="detail-field">
        <span class="detail-field__label">SĐT</span>
        <span class="detail-field__value">@Model.Phone</span>
    </div>
    <div class="detail-field">
        <span class="detail-field__label">Email</span>
        <span class="detail-field__value">@Model.Email</span>
    </div>
    <label class="detail-field">
        <span class="detail-field__label">CCCD *</span>
        <input name="citizenId" class="form-control" required maxlength="20" inputmode="numeric" value="@Model.CitizenId" />
    </label>
    <div class="detail-field">
        <span class="detail-field__label">Status</span>
        <span class="detail-field__value">@Model.Status</span>
    </div>
    @if (Model.Status is DealerStatus.Pending or DealerStatus.Rejected or DealerStatus.Approved)
    {
        <label class="detail-field">
            <span class="detail-field__label">@(Model.Status == DealerStatus.Approved ? "Chiết khấu % *" : "Chiết khấu % (khi duyệt)")</span>
            <input name="discountPercent" type="number" min="0" max="100" step="0.01" class="form-control"
                   value="@(Model.DiscountPercent?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? (Model.Status == DealerStatus.Approved ? "0" : ""))" />
        </label>
    }
    <div class="detail-field detail-field--wide">
        <span class="detail-field__label">Địa chỉ</span>
        <span class="detail-field__value">@Model.Address</span>
    </div>
    <div class="detail-field detail-field--wide">
        <span class="detail-field__label">Ghi chú KH</span>
        <span class="detail-field__value">@(string.IsNullOrWhiteSpace(Model.Message) ? "-" : Model.Message)</span>
    </div>
    <label class="detail-field detail-field--wide">
        <span class="detail-field__label">Ghi chú nội bộ</span>
        <textarea name="internalNotes" class="form-control" rows="2">@Model.InternalNotes</textarea>
    </label>
</div>

@if (Model.Status is DealerStatus.Pending or DealerStatus.Rejected)
{
    <div class="order-actions" style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-top:1rem">
        <button type="button" class="btn-primary" data-action="approve" data-id="@Model.Id">Duyệt</button>
        @if (Model.Status == DealerStatus.Pending)
        {
            <button type="button" class="btn-link" data-action="reject" data-id="@Model.Id">Từ chối</button>
        }
    </div>
}
else if (Model.Status == DealerStatus.Approved)
{
    <div class="order-actions" style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-top:1rem">
        <button type="button" class="btn-primary" data-action="save" data-id="@Model.Id">Lưu</button>
    </div>
}

<div class="modal__actions">
    <button type="button" class="btn-secondary" data-close>Đóng</button>
</div>
