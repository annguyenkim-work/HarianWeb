@model IReadOnlyList<NewHarian.Application.Cms.CmsPageListItem>
@using NewHarian.Web.Areas.Admin
@{
    ViewData["Title"] = "Trang nội dung";
    Layout = "_AdminLayout";
    var module = ViewBag.Module as string;
    var modules = new[] { "home", "about", "company", "legal", "contact", "dealers" };
}

<div class="admin-toolbar">
    <h1>Trang nội dung (CMS)</h1>
</div>

@if (TempData["Success"] is string ok) { <p class="text-success">@ok</p> }
@if (TempData["Error"] is string err) { <p class="text-danger">@err</p> }

<form method="get" class="filter-bar filter-bar--row">
    <label>Nhóm trang
        <select name="module" class="form-control" onchange="this.form.submit()">
            <option value="">- Tất cả -</option>
            @foreach (var m in modules)
            {
                if (module == m)
                {
                    <option value="@m" selected>@CmsUiLabels.Module(m)</option>
                }
                else
                {
                    <option value="@m">@CmsUiLabels.Module(m)</option>
                }
            }
        </select>
    </label>
</form>

<table class="data-table">
    <thead>
        <tr>
            <th>Đường dẫn</th>
            <th>Nhóm</th>
            <th>Tiêu đề (VI)</th>
            <th>Đã đăng</th>
            <th>Cập nhật</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td><code>@p.Slug</code></td>
            <td>@CmsUiLabels.Module(p.ModuleCode)</td>
            <td>@p.TitleVi</td>
            <td>@(p.IsPublished ? "Có" : "Không")</td>
            <td>@(p.UpdatedAt?.ToLocalTime().ToString("g") ?? "-")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@p.Id">Thông tin trang</a>
                ·
                <a asp-action="Blocks" asp-route-id="@p.Id">Nội dung</a>
            </td>
        </tr>
    }
    </tbody>
</table>
