@model NewHarian.Application.Cms.CmsBlockSaveRequest
@using NewHarian.Domain.Enums
@using NewHarian.Web.Areas.Admin
@{
    var typeLabel = CmsUiLabels.BlockType(Model.BlockType);
    ViewData["Title"] = Model.Id > 0 ? $"Sửa - {typeLabel}" : $"Thêm - {typeLabel}";
    Layout = "_AdminLayout";
    var pageId = Model.PageId;
    var isImageText = Model.BlockType == ContentBlockType.TextWithImage;
    var isTable = Model.BlockType == ContentBlockType.DataTable;
    var isCta = Model.BlockType == ContentBlockType.CtaButton;
    var isSupported = CmsUiLabels.IsSupported(Model.BlockType);
    var useRichText = isSupported && !isTable && !isCta;
    var extraJson = Model.ExtraData ?? """{"rows":[]}""";
}

<div class="admin-toolbar">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="Blocks" asp-route-id="@pageId" class="btn-link">← Nội dung trang</a>
</div>

@if (!isSupported)
{
    <p class="text-danger">Đây là kiểu khối cũ. Nên tạo mới bằng một trong bốn kiểu hỗ trợ, rồi xóa khối này.</p>
}

<form method="post" enctype="multipart/form-data" class="form-stack admin-sheet--xl" id="block-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PageId" />
    <input type="hidden" asp-for="BlockType" />
    <input type="hidden" asp-for="MediaFileId" />
    <input type="hidden" asp-for="ExtraData" id="ExtraData" />

    <label><input asp-for="IsPublished" type="checkbox" /> Hiển thị công khai</label>

    <label>Khoảng cách với block tiếp theo (rem)
        <input asp-for="SpacingAfterRem" type="number" min="0" step="0.05" class="form-control" required />
    </label>
    <p class="muted">Mặc định 0,35. Đặt <strong>0</strong> để block sát block kế tiếp (ảnh/chữ liền nhau).</p>

    @if (isImageText || Model.BlockType is ContentBlockType.ZigzagFeature or ContentBlockType.ImageGallery)
    {
        <label>Tải ảnh lên
            <input type="file" name="imageFile" accept="image/*" class="form-control" />
        </label>
        <p class="img-size-hint"><strong>Kích thước đề xuất:</strong> 1200×800 px (ngang 3:2). JPG/PNG/WEBP, ≤ 10MB. Các block ảnh liền nhau nên cùng tỷ lệ để layout không lệch chiều cao.</p>
        <label>Vị trí ảnh
            <select asp-for="ImagePosition" class="form-control">
                <option value="right">Ảnh bên phải</option>
                <option value="left">Ảnh bên trái</option>
            </select>
        </label>
        <label>Liên kết khi bấm ảnh (tuỳ chọn) <input asp-for="LinkUrl" class="form-control" placeholder="/products" /></label>
    }

    @if (isCta)
    {
        <section class="cta-editor">
            <h2>Nút liên kết</h2>
            <p class="muted">Khách bấm nút sẽ mở trang trong website (ví dụ <code>/products</code>) hoặc website khác (ví dụ <code>https://...</code>).</p>
            <label>Đường dẫn khi bấm nút *
                <input asp-for="LinkUrl" class="form-control" placeholder="/products hoặc https://example.com" />
            </label>
            <h3>Chữ trên nút</h3>
            <div class="lang-tabs" data-lang-tabs>
                <partial name="_LangTabBar" model="@("cta-lang")" />
                <div class="lang-tabs__panel is-active" id="cta-lang-panel-vi" role="tabpanel" aria-labelledby="cta-lang-tab-vi" data-lang-panel="vi">
                    <label>Chữ trên nút * <input asp-for="TitleVi" class="form-control" placeholder="Xem sản phẩm" /></label>
                </div>
                <div class="lang-tabs__panel" id="cta-lang-panel-en" role="tabpanel" aria-labelledby="cta-lang-tab-en" data-lang-panel="en" hidden>
                    <label>Chữ trên nút <input asp-for="TitleEn" class="form-control" placeholder="View products" /></label>
                </div>
                <div class="lang-tabs__panel" id="cta-lang-panel-ja" role="tabpanel" aria-labelledby="cta-lang-tab-ja" data-lang-panel="ja" hidden>
                    <label>Chữ trên nút <input asp-for="TitleJa" class="form-control" placeholder="製品を見る" /></label>
                </div>
            </div>
        </section>
    }

    @if (isTable)
    {
        <section class="table-editor">
            <div class="admin-toolbar toolbar-flush">
                <h2 class="u-m0">Các dòng bảng</h2>
                <button type="button" class="btn-secondary" id="btn-add-row">+ Thêm dòng</button>
            </div>
            <p class="muted">Mỗi dòng có tab ngôn ngữ. Nhãn là cột trái, nội dung là cột phải.</p>
            <div id="table-rows" class="table-rows"></div>
        </section>
        <h2>Tiêu đề khối (tuỳ chọn)</h2>
        <div class="lang-tabs" data-lang-tabs>
            <partial name="_LangTabBar" model="@("table-lang")" />
            <div class="lang-tabs__panel is-active" id="table-lang-panel-vi" role="tabpanel" aria-labelledby="table-lang-tab-vi" data-lang-panel="vi">
                <label>Tiêu đề <input asp-for="TitleVi" class="form-control" /></label>
            </div>
            <div class="lang-tabs__panel" id="table-lang-panel-en" role="tabpanel" aria-labelledby="table-lang-tab-en" data-lang-panel="en" hidden>
                <label>Tiêu đề <input asp-for="TitleEn" class="form-control" /></label>
            </div>
            <div class="lang-tabs__panel" id="table-lang-panel-ja" role="tabpanel" aria-labelledby="table-lang-tab-ja" data-lang-panel="ja" hidden>
                <label>Tiêu đề <input asp-for="TitleJa" class="form-control" /></label>
            </div>
        </div>
    }

    @if (useRichText || (!isSupported && !isCta))
    {
        <div class="lang-tabs" data-lang-tabs>
            <partial name="_LangTabBar" model="@("block-lang")" />
            <p class="lang-tabs__hint">Nội dung ở tab khác vẫn được lưu.</p>
            <div class="lang-tabs__panel is-active" id="block-lang-panel-vi" role="tabpanel" aria-labelledby="block-lang-tab-vi" data-lang-panel="vi">
                <div class="lang-tabs__fields">
                    <label>Tiêu đề <input asp-for="TitleVi" class="form-control" /></label>
                    <label>Nội dung <textarea asp-for="BodyVi" class="form-control richtext" rows="8"></textarea></label>
                </div>
            </div>
            <div class="lang-tabs__panel" id="block-lang-panel-en" role="tabpanel" aria-labelledby="block-lang-tab-en" data-lang-panel="en" hidden>
                <div class="lang-tabs__fields">
                    <label>Tiêu đề <input asp-for="TitleEn" class="form-control" /></label>
                    <label>Nội dung <textarea asp-for="BodyEn" class="form-control richtext" rows="6"></textarea></label>
                </div>
            </div>
            <div class="lang-tabs__panel" id="block-lang-panel-ja" role="tabpanel" aria-labelledby="block-lang-tab-ja" data-lang-panel="ja" hidden>
                <div class="lang-tabs__fields">
                    <label>Tiêu đề <input asp-for="TitleJa" class="form-control" /></label>
                    <label>Nội dung <textarea asp-for="BodyJa" class="form-control richtext" rows="6"></textarea></label>
                </div>
            </div>
        </div>
    }

    <button type="submit" class="btn-primary">Lưu</button>
</form>

@section Scripts {
@if (useRichText)
{
<script src="https://cdn.jsdelivr.net/npm/tinymce@7.6.0/tinymce.min.js" referrerpolicy="origin"></script>
<script>
function initBlockEditors(scope) {
  if (!window.tinymce) return;
  var root = scope || document.getElementById('block-form');
  if (!root) return;
  var token = document.querySelector('#block-form input[name="__RequestVerificationToken"]')?.value;
  if (!window.AdminRichText) return;
  AdminRichText.init(root.querySelectorAll('textarea.richtext'), {
    menubar: false,
    plugins: 'lists link table code autoresize image media',
    toolbar: 'undo redo | styles | bold italic underline | alignleft aligncenter alignright | bullist numlist | link image media table | removeformat | code',
    branding: false,
    license_key: 'gpl',
    promotion: false,
    automatic_uploads: true,
    images_reuse_filename: true,
    file_picker_types: 'image media',
    images_upload_handler: function (blobInfo) {
      return new Promise(function (resolve, reject) {
        var fd = new FormData();
        fd.append('file', blobInfo.blob(), blobInfo.filename());
        if (token) fd.append('__RequestVerificationToken', token);
        fetch('@Url.Action("UploadImage", "Pages")', { method: 'POST', body: fd })
          .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
          .then(function (result) {
            if (!result.ok || !result.data?.ok || !result.data.url) {
              reject(result.data?.error || 'Upload ảnh thất bại.');
              return;
            }
            resolve(result.data.url);
          })
          .catch(function () { reject('Upload ảnh thất bại.'); });
      });
    },
    valid_elements: '*[*]',
    extended_valid_elements: 'iframe[src|width|height|frameborder|allow|allowfullscreen|style|class|id|title|loading|referrerpolicy],video[*],audio[*],source[*],style[*]',
    valid_children: '+body[style],+div[style]',
    verify_html: false,
    sandbox_iframes: false,
    media_live_embeds: true,
    content_style: 'body { font-family: Segoe UI, sans-serif; font-size: 14px; } img, video, iframe { max-width: 100%; height: auto; }'
  });
}
document.addEventListener('DOMContentLoaded', function () {
  initBlockEditors();
  var form = document.getElementById('block-form');
  if (form) {
    form.addEventListener('submit', function () {
      if (window.tinymce) tinymce.triggerSave();
    });
  }
});
document.addEventListener('admin-lang-shown', function (e) {
  if (e.target instanceof Element && e.target.closest('#block-form')) initBlockEditors(e.target);
});
</script>
}
@if (isTable)
{
<script src="~/js/admin-cms-table-editor.js" asp-append-version="true"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  window.initCmsTableEditor({
    initialJson: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(extraJson))
  });
});
</script>
}
}
