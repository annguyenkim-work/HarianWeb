@model NewHarian.Web.ViewComponents.CompanyContactViewComponent.CompanyContactVm

<h2 class="contact-aside__name">@Model.CompanyName</h2>
@if (!string.IsNullOrWhiteSpace(Model.Tagline))
{
    <p class="muted">@Model.Tagline</p>
}
<dl class="contact-facts">
    @if (!string.IsNullOrWhiteSpace(Model.Address))
    {
        <div>
            <dt>@Localizer["Contact.Address"]</dt>
            <dd>@Model.Address</dd>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Email))
    {
        <div>
            <dt>@Localizer["Contact.Email"]</dt>
            <dd><a href="mailto:@Model.Email">@Model.Email</a></dd>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Phone) || !string.IsNullOrWhiteSpace(Model.Phone2))
    {
        <div>
            <dt>@Localizer["Contact.Phone"]</dt>
            <dd>
                @if (!string.IsNullOrWhiteSpace(Model.Phone))
                {
                    <a href="tel:@Model.Phone.Replace(" ", "")">@Model.Phone</a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Phone2))
                {
                    if (!string.IsNullOrWhiteSpace(Model.Phone))
                    {
                        <span> · </span>
                    }
                    <a href="tel:@Model.Phone2.Replace(" ", "")">@Model.Phone2</a>
                }
            </dd>
        </div>
    }
</dl>
