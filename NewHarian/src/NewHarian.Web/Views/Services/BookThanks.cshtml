@model NewHarian.Application.Catalog.ProductDetailDto
@{
    ViewData["Title"] = Localizer["Book.Thanks"];
}

<section class="page-hero">
    <h1>@Localizer["Book.Thanks"]</h1>
    <p class="note note-ok">@Localizer["Book.ThanksBody"] <strong id="booking-no" class="num">@ViewBag.BookingNumber</strong></p>
    <p class="muted">@Model.Name</p>
    <a class="btn-primary" asp-controller="Services" asp-action="Index">@Localizer["Nav.Services"]</a>
</section>
