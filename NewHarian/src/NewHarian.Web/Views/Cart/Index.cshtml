@model NewHarian.Application.Cart.CartDto
@{
    ViewData["Title"] = Localizer["Cart.Title"];
}

<nav class="breadcrumb">
    <a asp-controller="Home" asp-action="Index">@Localizer["Nav.Home"]</a> /
    <span>@Localizer["Cart.Title"]</span>
</nav>

<h1>@Localizer["Cart.Title"]</h1>

@if (TempData["Error"] is string err)
{
    <p class="text-danger">@err</p>
}

@if (Model.Items.Count == 0)
{
    <p class="muted">@Localizer["Cart.Empty"]</p>
    <a asp-controller="Products" asp-action="Index" class="btn-primary">@Localizer["Nav.Products"]</a>
}
else
{
    <div class="cart-layout">
        <table class="data-table">
            <thead>
                <tr>
                    <th></th>
                    <th>@Localizer["Cart.Item"]</th>
                    <th>SKU</th>
                    <th>@Localizer["Products.Qty"]</th>
                    <th>@Localizer["Cart.Price"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var i in Model.Items)
            {
                <tr class="js-cart-row">
                    <td class="cart-thumb">
                        @if (!string.IsNullOrEmpty(i.ImageUrl))
                        {
                            <img src="@i.ImageUrl" alt="@i.ProductName" />
                        }
                    </td>
                    <td>@i.DisplayName</td>
                    <td>@i.Sku</td>
                    <td>
                        <form asp-action="Update" method="post" class="inline-form js-cart-qty">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productVariantId" value="@i.ProductVariantId" />
                            <input type="number" name="quantity" value="@i.Quantity" min="1" class="qty-input" />
                        </form>
                    </td>
                    <td class="js-line-total">@i.LineTotal.ToString("N0")đ</td>
                    <td>
                        <form asp-action="Remove" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productVariantId" value="@i.ProductVariantId" />
                            <button type="submit" class="btn-link">@Localizer["Cart.Remove"]</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>

        <aside class="cart-summary">
            <p><strong>@Localizer["Cart.Subtotal"]:</strong> <span id="cart-subtotal">@Model.SubTotal.ToString("N0")đ</span></p>
            <p class="muted">@Localizer["Cart.ShipHint"]</p>
            <a class="btn-primary" asp-controller="Checkout" asp-action="Index">@Localizer["Cart.Checkout"]</a>
            <a class="btn-secondary" asp-controller="Products" asp-action="Index">@Localizer["Cart.Continue"]</a>
        </aside>
    </div>
}

@section Scripts {
<script>
(() => {
  const subtotalEl = document.getElementById('cart-subtotal');

  async function save(form) {
    const input = form.querySelector('[name="quantity"]');
    const qty = Math.max(1, parseInt(input.value, 10) || 1);
    input.value = qty;
    if (input.dataset.lastSaved === String(qty)) return;

    const res = await fetch(form.action, {
      method: 'POST',
      body: new FormData(form),
      headers: { 'Accept': 'application/json' }
    });
    const data = await res.json().catch(() => null);
    if (!res.ok || !data?.ok) {
      alert(data?.error || 'Không cập nhật được số lượng.');
      return;
    }
    if (String(input.value) !== String(data.quantity)) return;
    input.dataset.lastSaved = String(data.quantity);
    const row = form.closest('.js-cart-row');
    const lineEl = row?.querySelector('.js-line-total');
    if (lineEl) lineEl.textContent = data.lineTotalText;
    if (subtotalEl) subtotalEl.textContent = data.subTotalText;
  }

  document.querySelectorAll('.js-cart-qty').forEach(form => {
    const input = form.querySelector('[name="quantity"]');
    input.dataset.lastSaved = String(input.value);
    let timer;
    form.addEventListener('submit', e => {
      e.preventDefault();
      clearTimeout(timer);
      save(form);
    });
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => save(form), 400);
    });
    input.addEventListener('change', () => {
      clearTimeout(timer);
      save(form);
    });
  });
})();
</script>
}
