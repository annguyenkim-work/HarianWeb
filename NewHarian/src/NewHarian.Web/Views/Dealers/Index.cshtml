@model NewHarian.Application.Dealers.DealerFormModel
@using NewHarian.Domain.Enums
@{
    ViewData["Title"] = Localizer["Dealers.PageTitle"];
}

<section class="page-hero">
    <h1>@Localizer["Dealers.PageTitle"]</h1>
</section>
<nav class="breadcrumb">
    <a asp-controller="Home" asp-action="Index">@Localizer["Nav.Home"]</a>
    <span>/</span>
    <a href="/dealers/home">@Localizer["Nav.Dealers"]</a>
    <span>/</span>
    <span>@Localizer["Dealers.PageTitle"]</span>
</nav>

<main class="content-main content-main--full">
@if (TempData["Error"] is string err) { <p class="text-danger">@err</p> }
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<p class="muted">@Localizer["Dealers.Intro"]</p>
<form method="post" enctype="multipart/form-data" class="form-stack form-table" style="max-width:640px" data-dealer-form id="dealer-register-form">
    @Html.AntiForgeryToken()
    <label class="hp" aria-hidden="true"><input asp-for="Website" tabindex="-1" autocomplete="off" /></label>

    <fieldset class="dealer-type">
        <legend>@Localizer["Dealers.BusinessType"] *</legend>
        <label><input type="radio" name="BusinessType" value="Company" checked="@(Model.BusinessType != DealerBusinessType.Household)" /> @Localizer["Dealers.TypeCompany"]</label>
        <label><input type="radio" name="BusinessType" value="Household" checked="@(Model.BusinessType == DealerBusinessType.Household)" /> @Localizer["Dealers.TypeHousehold"]</label>
    </fieldset>

    <h2 class="form-section-title">@Localizer["Dealers.SectionBusiness"]</h2>
    <label>
        <span data-dealer-text="Company">@Localizer["Dealers.CompanyName"]</span><span data-dealer-text="Household" hidden>@Localizer["Dealers.HouseholdName"]</span> *
        <input asp-for="BusinessName" class="form-control" required maxlength="300" />
    </label>
    <label>@Localizer["Dealers.TaxCode"] *
        <input asp-for="TaxCode" class="form-control" required maxlength="20" autocomplete="off" />
        <span class="muted" style="display:block;margin-top:0.25rem" data-dealer-text="Company">@Localizer["Dealers.TaxCodeHintCompany"]</span>
        <span class="muted" style="display:block;margin-top:0.25rem" data-dealer-text="Household" hidden>@Localizer["Dealers.TaxCodeHintHousehold"]</span>
    </label>
    <label data-dealer-only="Household" hidden>@Localizer["Dealers.HouseholdRegistrationNo"] *
        <input asp-for="HouseholdRegistrationNo" class="form-control" required maxlength="50" />
    </label>
    <div>
        <strong>@Localizer["Dealers.HeadOfficeAddress"]</strong>
        @await Html.PartialAsync("~/Views/Shared/_AddressFields.cshtml", new AddressFieldsModel { ProvinceField = "ProvinceCode", CommuneField = "CommuneCode", LineField = "Address", ProvinceValue = Model.ProvinceCode, CommuneValue = Model.CommuneCode, LineValue = Model.Address })
    </div>
    <label>@Localizer["Dealers.BusinessLicense"]
        <input type="file" name="businessLicenseFile" class="form-control" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
        <span class="muted" style="display:block;margin-top:0.25rem">
            @if (!string.IsNullOrEmpty(Model.BusinessLicenseFileName))
            {
                @string.Format(Localizer["Dealers.BusinessLicenseKeep"].Value, Model.BusinessLicenseFileName)
            }
            else
            {
                @Localizer["Dealers.BusinessLicenseHint"]
            }
        </span>
    </label>

    <h2 class="form-section-title">@Localizer["Dealers.SectionRepresentative"]</h2>
    <label>
        <span data-dealer-text="Company">@Localizer["Dealers.LegalRepresentative"]</span><span data-dealer-text="Household" hidden>@Localizer["Dealers.HouseholdOwner"]</span> *
        <input asp-for="RepresentativeName" class="form-control" required maxlength="200" />
    </label>
    <label data-dealer-only="Company">@Localizer["Dealers.RepresentativeTitle"] *
        <input asp-for="RepresentativeTitle" class="form-control" required maxlength="100" />
    </label>
    <label>
        <span data-dealer-text="Company">@Localizer["Dealers.RepresentativeCitizenId"]</span><span data-dealer-text="Household" hidden>@Localizer["Dealers.OwnerCitizenId"] *</span>
        <input asp-for="CitizenId" class="form-control" maxlength="20" inputmode="numeric" autocomplete="off" data-required-for="Household" />
        <span class="muted" style="display:block;margin-top:0.25rem">@Localizer["Checkout.CitizenIdHint"]</span>
    </label>

    <h2 class="form-section-title">@Localizer["Dealers.SectionContact"]</h2>
    <label>@Localizer["Dealers.ContactPerson"] * <input asp-for="FullName" class="form-control" required maxlength="200" /></label>
    <label>@Localizer["Contact.Phone"] * <input asp-for="Phone" class="form-control" required maxlength="20" /></label>
    <label>@Localizer["Contact.Email"] * <input asp-for="Email" type="email" class="form-control" required maxlength="200" /></label>

    <h2 class="form-section-title">@Localizer["Dealers.SectionShipping"]</h2>
    <label class="form-check"><input asp-for="ShipToHeadOffice" /> @Localizer["Dealers.ShipToHeadOffice"]</label>
    <fieldset data-dealer-shipping style="border:0;padding:0;margin:0;min-width:0" hidden="@Model.ShipToHeadOffice" disabled="@Model.ShipToHeadOffice">
        <strong>@Localizer["Dealers.ShippingAddress"]</strong>
        @await Html.PartialAsync("~/Views/Shared/_AddressFields.cshtml", new AddressFieldsModel { ProvinceField = "ShippingProvinceCode", CommuneField = "ShippingCommuneCode", LineField = "ShippingAddress", ProvinceValue = Model.ShippingProvinceCode, CommuneValue = Model.ShippingCommuneCode, LineValue = Model.ShippingAddress })
    </fieldset>
    <label>@Localizer["Dealers.InvoiceEmail"]
        <input asp-for="InvoiceEmail" type="email" class="form-control" maxlength="200" />
        <span class="muted" style="display:block;margin-top:0.25rem">@Localizer["Dealers.InvoiceEmailHint"]</span>
    </label>

    <label>@Localizer["Contact.Message"] <textarea asp-for="Message" class="form-control" rows="5" maxlength="2000"></textarea></label>
    <button type="submit" class="btn-primary">@Localizer["Contact.Continue"]</button>
</form>
</main>
<style>.hp{position:absolute;left:-9999px;height:0;overflow:hidden}.dealer-type{border:0;padding:0;margin:0;display:flex;gap:1.5rem;flex-wrap:wrap}.form-section-title{font-size:1.1rem;margin:1rem 0 0}</style>
@section Scripts {
    <script src="~/js/dealer-form.js" asp-append-version="true"></script>
}
