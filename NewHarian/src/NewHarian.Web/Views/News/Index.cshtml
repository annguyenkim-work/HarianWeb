@model IReadOnlyList<NewHarian.Application.Posts.SitePostListItemDto>
@{
    ViewData["Title"] = Localizer["Nav.News"].Value ?? "Tin tức";
}

<section class="page-hero"><h1>@ViewData["Title"]</h1></section>
<nav class="breadcrumb">
    <a asp-controller="Home" asp-action="Index">@Localizer["Nav.Home"]</a>
    <span>/</span>
    <span>@ViewData["Title"]</span>
</nav>

@if (Model.Count == 0)
{
    <p class="muted">-</p>
}
else
{
    <div class="post-list">
        @foreach (var p in Model)
        {
            <a class="post-card" asp-action="Detail" asp-route-slug="@p.Slug">
                @if (!string.IsNullOrWhiteSpace(p.CoverImageUrl))
                {
                    <img src="@p.CoverImageUrl" alt="" />
                }
                <div class="post-card__body">
                    <h2>@p.Title</h2>
                    @if (p.PublishedAt is DateTime dt)
                    {
                        <p class="muted">@dt.ToLocalTime().ToString("dd/MM/yyyy")</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(p.Excerpt))
                    {
                        <p>@p.Excerpt</p>
                    }
                </div>
            </a>
        }
    </div>
}
