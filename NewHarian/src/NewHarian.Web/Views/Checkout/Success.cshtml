@model NewHarian.Application.Orders.OrderSummaryDto
@{
    ViewData["Title"] = Localizer["Checkout.Success"];
    var isCod = Model.PaymentMethod == NewHarian.Domain.Enums.PaymentMethod.COD;
    var isBank = Model.PaymentMethod == NewHarian.Domain.Enums.PaymentMethod.BankTransfer;
}

<section class="page-hero">
    <h1>@Localizer["Checkout.Success"]</h1>
    <p class="note note-ok">@Localizer["Checkout.OrderNo"]: <strong id="order-no" class="badge-code">@Model.OrderNumber</strong></p>
    @if (!string.IsNullOrWhiteSpace(Model.CitizenId))
    {
        <p>@Localizer["Checkout.CitizenId"]: <strong>@Model.CitizenId</strong></p>
    }
</section>

@if (isCod)
{
    <p>@Localizer["Checkout.CodMsg"]</p>
}
else if (isBank)
{
    <partial name="_BankTransferInfo" />
}

<table class="data-table">
    <tbody>
    @foreach (var i in Model.Items)
    {
        <tr>
            <td>@(string.IsNullOrWhiteSpace(i.VariantLabel) ? i.ProductName : $"{i.ProductName} - {i.VariantLabel}")</td>
            <td>× @i.Quantity</td>
            <td class="num">@i.LineTotal.ToString("N0") VNĐ</td>
        </tr>
    }
    @if (!string.IsNullOrEmpty(Model.PromoCode))
    {
        <tr data-success-promo data-promo-code="@Model.PromoCode"><td colspan="2">@Localizer["Checkout.PromoDiscount"] (@Model.PromoCode)</td><td class="num">-@Model.DiscountAmount.ToString("N0") VNĐ</td></tr>
    }
    else if (Model.DiscountAmount > 0)
    {
        <tr><td colspan="2">@Localizer["Checkout.DealerDiscount"]</td><td class="num" data-success-discount>-@Model.DiscountAmount.ToString("N0") VNĐ</td></tr>
    }
    <tr><td colspan="2">@Localizer["Checkout.Total"]</td><td class="num"><strong>@Model.Total.ToString("N0") VNĐ</strong></td></tr>
    </tbody>
</table>

<p><a asp-controller="Orders" asp-action="Track" class="btn-primary">@Localizer["Orders.Track"]</a>
   <a asp-controller="Products" asp-action="Index" class="btn-secondary">@Localizer["Nav.Products"]</a></p>
