@model NewHarian.Application.Orders.CheckoutDraft
@{
    ViewData["Title"] = Localizer["Checkout.Confirm"];
    var priced = (NewHarian.Application.Cart.PricedCart)ViewBag.Priced;
    var dealer = ViewBag.Dealer as NewHarian.Application.Dealers.DealerOptionDto;
    var total = (decimal)ViewBag.Total;
    var shipTo = (string)(ViewBag.ShipTo ?? "");
    var promo = ViewBag.Promo as NewHarian.Application.PromoCodes.PromoQuote ?? NewHarian.Application.PromoCodes.PromoQuote.None;
    var colspan = priced.IsDealer ? 3 : 2;
}

<nav class="breadcrumb">
    <a asp-action="Index">@Localizer["Checkout.Title"]</a> /
    <span>@Localizer["Checkout.Confirm"]</span>
</nav>

<h1>@Localizer["Checkout.Confirm"]</h1>

@if (TempData["Error"] is string err)
{
    <p class="text-danger">@err</p>
}
@if (ViewBag.DealerNotice is string notice)
{
    <p class="text-danger" data-dealer-notice>@notice</p>
}

<section class="confirm-block">
    @if (dealer is not null)
    {
        <p data-dealer-active>@Localizer["Checkout.DealerCode.Active"] <strong>@dealer.BusinessName</strong></p>
    }
    <h2>@Localizer["Checkout.Customer"]</h2>
    <p>
        @Model.CustomerName<br />@Model.CustomerEmail<br />@Model.CustomerPhone
        @if (!string.IsNullOrWhiteSpace(Model.CitizenId))
        {
            <br />@Localizer["Checkout.CitizenId"]<text>: </text>@Model.CitizenId
        }
    </p>
    <h2>@Localizer["Checkout.ShipTo"]</h2>
    <p>@shipTo</p>
    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <p><strong>@Localizer["Checkout.Notes"]:</strong> @Model.Notes</p>
    }
    <p><strong>@Localizer["Checkout.Payment"]:</strong>
        @(Model.PaymentMethod == NewHarian.Domain.Enums.PaymentMethod.COD ? Localizer["Checkout.COD"] : Localizer["Checkout.Bank"])
    </p>
</section>

@if (dealer is not null)
{
    <partial name="_DealerInvoiceBlock" model="dealer" />
}

<table class="data-table">
    <thead>
        <tr>
            <th>@Localizer["Cart.Item"]</th>
            <th>@Localizer["Products.Qty"]</th>
            @if (priced.IsDealer)
            {
                <th>@Localizer["Checkout.DealerDiscount"]</th>
            }
            <th>@Localizer["Cart.Price"]</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var line in priced.Lines)
    {
        var i = line.Item;
        <tr data-confirm-sku="@i.Sku">
            <td>@(string.IsNullOrWhiteSpace(i.VariantLabel) ? i.ProductName : $"{i.ProductName} - {i.VariantLabel}") <span class="badge-code">@i.Sku</span></td>
            <td class="num">@i.Quantity</td>
            @if (priced.IsDealer)
            {
                <td data-line-discount><partial name="_DealerLineDiscount" model="line" /></td>
            }
            <td class="num">@i.LineTotal.ToString("N0") VNĐ</td>
        </tr>
    }
    </tbody>
    <tfoot>
        <tr><td colspan="@colspan">@Localizer["Cart.Subtotal"]</td><td class="num">@priced.SubTotal.ToString("N0") VNĐ</td></tr>
        @if (priced.IsDealer)
        {
            <tr><td colspan="@colspan">@Localizer["Checkout.DealerDiscount"]</td><td class="num" data-confirm-discount>-@priced.DiscountAmount.ToString("N0") VNĐ</td></tr>
        }
        @if (promo.HasDiscount)
        {
            <tr data-confirm-promo data-promo-code="@promo.Code"><td colspan="@colspan">@Localizer["Checkout.PromoDiscount"] (@promo.Code)</td><td class="num">-@promo.Amount.ToString("N0") VNĐ</td></tr>
        }
        @{ ViewData["ShipColSpan"] = colspan; }
        <partial name="_ShippingFeeLine" model="0m" />
        <tr><td colspan="@colspan"><strong>@Localizer["Checkout.Total"]</strong></td><td class="num"><strong data-confirm-total>@total.ToString("N0") VNĐ</strong></td></tr>
    </tfoot>
</table>

<div class="action-row">
    <a class="btn-secondary" asp-action="Index">@Localizer["Checkout.Edit"]</a>
    <form asp-action="Submit" method="post"
          data-submit-once
          data-busy-label="@Localizer["Common.Processing"]">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-primary">@Localizer["Checkout.Place"]</button>
    </form>
</div>

@await Html.PartialAsync("_SubmitOnce")
