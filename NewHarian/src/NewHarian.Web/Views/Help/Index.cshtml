@{
    ViewData["Title"] = "Hướng dẫn sử dụng";
}

<section class="page-hero">
    <h1>Hướng dẫn sử dụng</h1>
    <p class="muted">Dành cho khách hàng - mua sản phẩm, đặt lịch dịch vụ và theo dõi đơn hàng.</p>
</section>

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a asp-controller="Home" asp-action="Index">@Localizer["Nav.Home"]</a>
    <span>/</span>
    <span>Hướng dẫn sử dụng</span>
</nav>

<main class="content-main content-main--full help-page">
    <nav class="help-toc" aria-label="Mục lục">
        <strong>Mục lục</strong>
        <ol>
            <li><a href="#quy-trinh">Quy trình bán hàng</a></li>
            <li><a href="#buoc-1">Bước 1 - Chọn sản phẩm</a></li>
            <li><a href="#buoc-2">Bước 2 - Chi tiết &amp; thêm giỏ</a></li>
            <li><a href="#buoc-3">Bước 3 - Giỏ hàng</a></li>
            <li><a href="#buoc-4">Bước 4 - Thanh toán</a></li>
            <li><a href="#buoc-5">Bước 5 - Xác nhận đơn</a></li>
            <li><a href="#buoc-6">Bước 6 - Đặt hàng thành công</a></li>
            <li><a href="#buoc-7">Bước 7 - Tra cứu đơn</a></li>
            <li><a href="#dat-lich">Đặt lịch dịch vụ</a></li>
