@model NewHarian.Web.Controllers.OrdersController.TrackForm
@{
    ViewData["Title"] = Localizer["Orders.Track"];
    var order = ViewBag.Order as NewHarian.Application.Orders.OrderSummaryDto;
}

<h1>@Localizer["Orders.Track"]</h1>

@if (TempData["Success"] is string ok) { <p class="text-success">@ok</p> }
@if (TempData["Error"] is string err) { <p class="text-danger">@err</p> }

<form method="post" class="form-stack">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <label>@Localizer["Orders.OrderNo"] <input asp-for="OrderNumber" class="form-control" required placeholder="HAR-ORDER-0001" /></label>
    <label>@Localizer["Book.Email"] <input asp-for="CustomerEmail" type="email" class="form-control" required /></label>
    <button type="submit" class="btn-primary">@Localizer["Orders.Lookup"]</button>
</form>

@if (ViewBag.NotFound == true)
{
    <p class="text-danger">@Localizer["Orders.NotFound"]</p>
}

@if (order is not null)
{
    <section class="confirm-block confirm-block--spaced">
        <h2><span class="badge-code">@order.OrderNumber</span></h2>
        @{
            var histories = ViewBag.Histories as IReadOnlyList<NewHarian.Application.Admin.StatusHistoryItemDto>
                            ?? Array.Empty<NewHarian.Application.Admin.StatusHistoryItemDto>();
            if (histories.Count == 0)
            {
                histories =
                [
                    new NewHarian.Application.Admin.StatusHistoryItemDto(
                        0, order.CreatedAt, NewHarian.Application.Admin.StatusHistoryEventTypes.Created,
                        "Guest", null, "", null, null)
                ];
            }
        }
        <partial name="_OrderTimeline" model="histories" />
        <p>@Localizer["Orders.Status"]: <span class="@NewHarian.Application.Orders.OrderStatusTone.BadgeClass(order.Status)">@Localizer[NewHarian.Application.Orders.OrderStatusTone.LabelKey(order.Status)]</span></p>
        <p>@Localizer["Checkout.Payment"]: @order.PaymentMethod</p>
        <p>@AddressFormat.Join(order.ShippingAddress, order.ShippingDistrict, order.ProvinceName)</p>
        @if (!string.IsNullOrWhiteSpace(order.CitizenId))
        {
            <p>@Localizer["Checkout.CitizenId"]: @order.CitizenId</p>
        }
        <p>@order.CreatedAt.ToLocalTime().ToString("g")</p>
        <table class="data-table">
            <thead>
                <tr>
                    <th>@Localizer["Cart.Item"]</th>
                    <th>@Localizer["Products.Qty"]</th>
                    <th>@Localizer["Cart.Price"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var i in order.Items)
            {
                <tr>
                    <td>@(string.IsNullOrWhiteSpace(i.VariantLabel) ? i.ProductName : $"{i.ProductName} ({i.VariantLabel})")</td>
                    <td class="num">@i.Quantity</td>
                    <td class="num">@i.LineTotal.ToString("N0") VNĐ</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr><td colspan="2">@Localizer["Cart.Subtotal"]</td><td class="num">@order.SubTotal.ToString("N0") VNĐ</td></tr>
                @if (!string.IsNullOrEmpty(order.PromoCode))
                {
                    <tr data-track-promo data-promo-code="@order.PromoCode"><td colspan="2">@Localizer["Checkout.PromoDiscount"] (@order.PromoCode)</td><td class="num">-@order.DiscountAmount.ToString("N0") VNĐ</td></tr>
                }
                else if (order.DiscountAmount > 0)
                {
                    <tr><td colspan="2">@Localizer["Checkout.DealerDiscount"]</td><td class="num">-@order.DiscountAmount.ToString("N0") VNĐ</td></tr>
                }
                <tr><td colspan="2">@Localizer["Checkout.Shipping"]</td><td class="num">@order.ShippingFee.ToString("N0") VNĐ</td></tr>
                <tr><td colspan="2"><strong>@Localizer["Checkout.Total"]</strong></td><td class="num"><strong>@order.Total.ToString("N0") VNĐ</strong></td></tr>
            </tfoot>
        </table>

        @if (order.Status == NewHarian.Domain.Enums.OrderStatus.PendingPayment
             && order.PaymentMethod == NewHarian.Domain.Enums.PaymentMethod.BankTransfer)
        {
            <partial name="_BankTransferInfo" />

            <form asp-action="Cancel" method="post" class="form-follow" onsubmit="return confirm(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Orders.CancelConfirm"].Value)));">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderNumber" value="@order.OrderNumber" />
                <input type="hidden" name="customerEmail" value="@order.CustomerEmail" />
                <button type="submit" class="btn-secondary">@Localizer["Orders.Cancel"]</button>
            </form>
        }
    </section>
}
